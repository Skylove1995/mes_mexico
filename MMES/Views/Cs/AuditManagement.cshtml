    <!-- JavaScript Logic -->
    <script>
        let calendarInstance = null;
        let deptScoreChart = null;
        let issueStatusChart = null;
        let allActiveSessions = [];

        document.addEventListener('DOMContentLoaded', async function () {
            await loadMetaOptions();
            initCalendar();
            loadScheduleSessions();
            loadConductActiveSessions();
        });

        function switchTab(tabName, btnElement) {
            document.querySelectorAll('.audit-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.audit-tab-panel').forEach(panel => panel.classList.remove('active'));

            var targetBtn = btnElement || (event && event.currentTarget ? event.currentTarget : null);
            if (targetBtn) targetBtn.classList.add('active');
            var targetPanel = document.getElementById('tab-' + tabName);
            if (targetPanel) targetPanel.classList.add('active');

            if (tabName === 'schedule' && calendarInstance) {
                setTimeout(() => calendarInstance.render(), 100);
            } else if (tabName === 'conduct') {
                loadConductActiveSessions();
            } else if (tabName === 'issues') {
                loadIssueList();
            } else if (tabName === 'summary') {
                loadSummaryMetrics();
            }
        }

        async function loadMetaOptions() {
            try {
                const [resTypes, resDepts, resUsers, resStatuses] = await Promise.all([
                    fetch('/api/audit/meta/types').then(r => r.json()),
                    fetch('/api/audit/meta/depts').then(r => r.json()),
                    fetch('/api/audit/meta/users').then(r => r.json()),
                    fetch('/api/audit/meta/statuses').then(r => r.json())
                ]);

                if (resTypes.success) {
                    const opts = resTypes.data.map(t => `<option value="${t.id}">${t.name}</option>`).join('');
                    document.getElementById('schedAuditType').innerHTML = '<option value="0">-- All Audit Types --</option>' + opts;
                    document.getElementById('conductFilterType').innerHTML = '<option value="0">-- All Audit Types --</option>' + opts;
                    document.getElementById('modalAuditTypeId').innerHTML = opts;
                }

                if (resDepts.success) {
                    const opts = resDepts.data.map(d => {
                        const label = (d.code && d.name && d.code !== d.name) ? `${d.code} - ${d.name}` : (d.name || d.code);
                        return `<option value="${d.id}">${label}</option>`;
                    }).join('');
                    document.getElementById('schedDept').innerHTML = '<option value="0">-- All Departments --</option>' + opts;
                    document.getElementById('conductFilterDept').innerHTML = '<option value="0">-- All Departments --</option>' + opts;
                    document.getElementById('issueDeptFilter').innerHTML = '<option value="0">-- All Departments --</option>' + opts;
                    document.getElementById('modalDeptId').innerHTML = opts;
                }

                if (resUsers.success) {
                    const opts = resUsers.data.map(u => `<option value="${u.id}">${u.name}</option>`).join('');
                    document.getElementById('modalAuditorId').innerHTML = '<option value="">-- Unassigned --</option>' + opts;
                }

                if (resStatuses.success) {
                    const opts = resStatuses.data.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
                    document.getElementById('issueStatusFilter').innerHTML = '<option value="0">-- All Statuses --</option>' + opts;
                }
            } catch (err) {
                console.error("Failed to load meta options:", err);
            }
        }

        function initCalendar() {
            var calendarEl = document.getElementById('auditCalendar');
            calendarInstance = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listMonth'
                },
                events: [],
                eventClick: function (info) {
                    if (info.event && info.event.id) {
                        openConductForSession(info.event.id);
                    }
                }
            });
            calendarInstance.render();
        }

        async function loadConductActiveSessions() {
            try {
                var res = await fetch('/api/audit/active-sessions').then(r => r.json());
                if (!res.success) return;

                allActiveSessions = res.data;
                renderConductSessionDropdown(allActiveSessions);
            } catch (err) {
                console.error("Failed to load conduct active sessions:", err);
            }
        }

        function renderConductSessionDropdown(sessions) {
            var select = document.getElementById('conductSessionSelect');
            var currentVal = select.value;
            var opts = sessions.map(s => {
                var dateStr = s.auditMonth ? s.auditMonth.split('T')[0] : '';
                return `<option value="${s.id}">Round #${s.id} - ${s.deptName} (${s.auditTypeName}) - ${dateStr} [${s.statusName}]</option>`;
            }).join('');

            select.innerHTML = '<option value="0">-- Choose Active Audit Session --</option>' + opts;

            if (currentVal && sessions.some(s => s.id == currentVal)) {
                select.value = currentVal;
            } else if (sessions.length > 0) {
                select.value = sessions[0].id;
                loadConductChecksheet();
            } else {
                document.getElementById('conductChecksheetBody').innerHTML = '<tr><td colspan="6" style="text-align:center;">No matching audit sessions found.</td></tr>';
                updateConductProgressBar(0, 0, 0, 0);
            }
        }

        function onConductFilterChange() {
            var typeId = parseInt(document.getElementById('conductFilterType').value) || 0;
            var deptId = parseInt(document.getElementById('conductFilterDept').value) || 0;
            var dateVal = document.getElementById('conductFilterDate').value;

            var filtered = allActiveSessions.filter(s => {
                var matchType = (typeId === 0 || s.auditTypeId === typeId);
                var matchDept = (deptId === 0 || s.deptId === deptId);
                var matchDate = (!dateVal || (s.auditMonth && s.auditMonth.startsWith(dateVal)));
                return matchType && matchDept && matchDate;
            });

            renderConductSessionDropdown(filtered);
        }

        async function loadScheduleSessions() {
            var typeId = document.getElementById('schedAuditType').value;
            var deptId = document.getElementById('schedDept').value;
            var year = document.getElementById('schedYear').value;

            try {
                var res = await fetch(`/api/audit/sessions?auditTypeId=${typeId}&deptId=${deptId}&year=${year}`).then(r => r.json());
                if (!res.success) return;

                var events = res.data.map(s => {
                    var statusName = s.statusName || 'Draft';
                    var color = '#f59e0b';
                    if (statusName === 'Approved') color = '#10b981';
                    else if (statusName === 'Checked') color = '#06b6d4';
                    else if (statusName === 'Submitted') color = '#2563eb';

                    return {
                        id: s.id,
                        title: `[${s.deptName}] ${s.auditTypeName} (${statusName})`,
                        start: s.auditMonth ? s.auditMonth.split('T')[0] : new Date().toISOString().split('T')[0],
                        backgroundColor: color,
                        borderColor: color,
                        textColor: '#ffffff'
                    };
                });

                if (calendarInstance) {
                    calendarInstance.removeAllEvents();
                    calendarInstance.addEventSource(events);
                }

                // Update Quick KPI Strip Bar Values
                var totalAudits = res.data.length;
                var openCapas = res.data.filter(s => s.statusName === 'Open' || s.statusName === 'Draft').length;
                var pendingAudits = res.data.filter(s => s.statusName === 'Submitted' || s.statusName === 'Checked').length;
                var validScores = res.data.filter(s => s.scorePercent != null);
                var avgScore = validScores.length > 0 ? Math.round(validScores.reduce((sum, item) => sum + item.scorePercent, 0) / validScores.length) : 100;

                if (document.getElementById('kpiStripTotal')) document.getElementById('kpiStripTotal').textContent = `(${totalAudits})`;
                if (document.getElementById('kpiStripOpen')) document.getElementById('kpiStripOpen').textContent = `(${openCapas})`;
                if (document.getElementById('kpiStripScore')) document.getElementById('kpiStripScore').textContent = `(${avgScore}%)`;
                if (document.getElementById('kpiStripPending')) document.getElementById('kpiStripPending').textContent = `(${pendingAudits})`;

                // Populate Session Select dropdown for Conduct tab
                var sessionOpts = res.data.map(s => `<option value="${s.id}">Round #${s.id} - ${s.deptName} (${s.auditTypeName}) [${s.statusName}]</option>`).join('');
                document.getElementById('conductSessionSelect').innerHTML = '<option value="0">-- Choose Active Audit Session --</option>' + sessionOpts;

                // Populate Table
                var rows = res.data.map(s => `
                    <tr>
                        <td><strong>#${s.id}</strong></td>
                        <td>${s.auditTypeName}</td>
                        <td><span class="status-badge status-submitted">${s.deptName}</span></td>
                        <td>${s.auditMonth ? s.auditMonth.split('T')[0] : 'N/A'}</td>
                        <td>${s.shift}</td>
                        <td>${s.auditorName}</td>
                        <td><strong>${s.scorePercent ?? 0}%</strong> (${s.grade ?? 'N/A'})</td>
                        <td><span class="status-badge status-${(s.statusName || 'draft').toLowerCase()}">${s.statusName}</span></td>
                        <td>
                            <button type="button" class="score-btn s8" style="width:auto; padding: 0 8px;" onclick="openConductForSession(${s.id})">Conduct</button>
                        </td>
                    </tr>
                `).join('');

                document.getElementById('schedSessionTableBody').innerHTML = rows || '<tr><td colspan="9" style="text-align:center;">No scheduled audit sessions found.</td></tr>';
            } catch (err) {
                console.error("Error loading schedule sessions:", err);
            }
        }

        function openCreateSessionModal() {
            document.getElementById('modalAuditMonth').value = new Date().toISOString().split('T')[0];
            document.getElementById('modalCreateSession').classList.add('active');
        }

        function closeCreateSessionModal() {
            document.getElementById('modalCreateSession').classList.remove('active');
        }

        async function handleCreateSessionSubmit(e) {
            e.preventDefault();
            var payload = {
                auditTypeId: parseInt(document.getElementById('modalAuditTypeId').value),
                deptId: parseInt(document.getElementById('modalDeptId').value),
                auditMonth: document.getElementById('modalAuditMonth').value,
                shift: document.getElementById('modalShift').value,
                auditorId: parseInt(document.getElementById('modalAuditorId').value) || null,
                note: document.getElementById('modalNote').value
            };

            var res = await fetch('/api/audit/sessions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(r => r.json());

            if (res.success) {
                closeCreateSessionModal();
                loadScheduleSessions();
                loadConductActiveSessions();
                alert("New audit round scheduled successfully!");
            } else {
                alert("Error: " + res.message);
            }
        }

        function openConductForSession(sessionId) {
            var conductTabBtn = document.querySelectorAll('.audit-tab-btn')[1];
            switchTab('conduct', conductTabBtn);
            loadConductActiveSessions().then(() => {
                document.getElementById('conductSessionSelect').value = sessionId;
                loadConductChecksheet();
            });
        }

        function updateConductProgressBar(totalItems, completedItems, okCount, ngCount) {
            var percent = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;
            document.getElementById('conductProgressText').textContent = `${completedItems} / ${totalItems} Completed (${percent}%)`;
            document.getElementById('badgeOkCount').textContent = `${okCount} OK`;
            document.getElementById('badgeNgCount').textContent = `${ngCount} NG`;
            document.getElementById('conductProgressBar').style.width = `${percent}%`;
        }

        function calculateChecksheetProgress() {
            var rows = document.querySelectorAll('#conductChecksheetBody tr[data-item-id]');
            var totalItems = rows.length;
            var completedItems = 0;
            var okCount = 0;
            var ngCount = 0;

            rows.forEach(r => {
                var selBtn = r.querySelector('.score-btn.selected');
                if (selBtn) {
                    completedItems++;
                    var val = parseFloat(selBtn.textContent.trim());
                    if (val >= 6) {
                        okCount++;
                    } else {
                        ngCount++;
                    }
                }
            });

            updateConductProgressBar(totalItems, completedItems, okCount, ngCount);
        }

        async function loadConductChecksheet() {
            var sessionId = document.getElementById('conductSessionSelect').value;
            if (sessionId <= 0) {
                document.getElementById('conductChecksheetBody').innerHTML = '<tr><td colspan="6" style="text-align:center;">Please select an active audit session to load the checksheet.</td></tr>';
                updateConductProgressBar(0, 0, 0, 0);
                
                // Unlock filters if no active session is selected
                document.getElementById('conductFilterType').disabled = false;
                document.getElementById('conductFilterDept').disabled = false;
                document.getElementById('conductFilterDate').disabled = false;
                return;
            }

            var res = await fetch(`/api/audit/sessions/${sessionId}/checksheet`).then(r => r.json());
            if (!res.success) return;

            var info = res.session;
            if (info) {
                // Auto pre-fill the 3 fields matching the active session
                var typeSelect = document.getElementById('conductFilterType');
                var deptSelect = document.getElementById('conductFilterDept');
                var dateInput = document.getElementById('conductFilterDate');

                if (info.auditTypeId) {
                    typeSelect.value = info.auditTypeId;
                }
                if (typeSelect.selectedIndex <= 0 && info.auditTypeName) {
                    Array.from(typeSelect.options).forEach(opt => {
                        if (opt.text.toLowerCase().includes(info.auditTypeName.toLowerCase())) {
                            typeSelect.value = opt.value;
                        }
                    });
                }

                if (info.deptId) {
                    deptSelect.value = info.deptId;
                }
                if (deptSelect.selectedIndex <= 0 && info.deptName) {
                    Array.from(deptSelect.options).forEach(opt => {
                        if (opt.text.toLowerCase().includes(info.deptName.toLowerCase())) {
                            deptSelect.value = opt.value;
                        }
                    });
                }

                if (info.auditMonth) {
                    dateInput.value = info.auditMonth.split('T')[0];
                }

                // Lock all 3 fields to prevent accidental edits / form corruption
                typeSelect.disabled = true;
                deptSelect.disabled = true;
                dateInput.disabled = true;
            }

            document.getElementById('conductSessionInfo').innerHTML = `
                Round #${info.id} | Dept: ${info.deptName} | Score: <strong>${info.scorePercent ?? 0}%</strong> (Grade ${info.grade ?? 'N/A'})
            `;

            var currentCat = "";
            var rowsHtml = "";

            res.items.forEach(item => {
                if (item.category !== currentCat) {
                    currentCat = item.category;
                    rowsHtml += `<tr class="category-header-row"><td colspan="6">📁 CATEGORY: ${currentCat}</td></tr>`;
                }

                var scoreVal = item.score;
                rowsHtml += `
                    <tr data-item-id="${item.id}">
                        <td class="mobile-hide-seq"><strong>#${item.seqNo || item.id}</strong></td>
                        <td class="mobile-hide-cat"><span class="status-badge status-submitted">${item.category}</span></td>
                        <td>
                            <div style="font-size: 0.92rem; line-height: 1.4; color: var(--text-color, #0f172a);">
                                <strong>#${item.seqNo || item.id}. ${item.auditItem}</strong>
                            </div>
                            ${item.auditItemTranslate ? `<div style="font-size:0.84rem; color:#64748b; margin-top:3px;">${item.auditItemTranslate}</div>` : ''}
                        </td>
                        <td>
                            <div class="rubric-btn-group">
                                ${[10, 8, 6, 4, 2, 0].map(s => `
                                    <button type="button" class="score-btn s${s} ${scoreVal === s ? 'selected' : ''}" onclick="setScore(this, ${item.id}, ${s})">${s}</button>
                                `).join('')}
                            </div>
                        </td>
                        <td>
                            <div class="item-action-row">
                                <input type="text" class="audit-input item-note" style="width: 100%;" value="${item.note || ''}" placeholder="Remarks / Evidence notes..." />
                                <div id="evidencePreview_${item.id}" class="evidence-preview-wrap"></div>
                            </div>
                        </td>
                        <td>
                            <div class="item-tools-bar">
                                <input type="file" id="cameraInput_${item.id}" accept="image/*" capture="environment" style="display:none;" onchange="uploadEvidencePhoto(event, ${item.id})" />
                                <button type="button" class="btn-camera-custom" onclick="triggerCamera(${item.id})">
                                    📷 <span>Photo</span>
                                </button>
                                <button type="button" class="score-btn s0" style="width:auto; padding: 0 10px; height: 34px;" onclick="createNCForResult(${sessionId}, ${item.id})">+ NC</button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('conductChecksheetBody').innerHTML = rowsHtml || '<tr><td colspan="6" style="text-align:center;">No checksheet questions found for this audit session.</td></tr>';
            calculateChecksheetProgress();
        }

        function triggerCamera(itemId) {
            var input = document.getElementById('cameraInput_' + itemId);
            if (input) input.click();
        }

        async function uploadEvidencePhoto(e, itemId) {
            var file = e.target.files[0];
            if (!file) return;

            var formData = new FormData();
            formData.append('file', file);

            try {
                var res = await fetch('/api/audit/evidence/upload', {
                    method: 'POST',
                    body: formData
                }).then(r => r.json());

                if (res.success) {
                    var container = document.getElementById('evidencePreview_' + itemId);
                    if (container) {
                        var imgThumb = document.createElement('div');
                        imgThumb.className = 'evidence-thumb-box';
                        imgThumb.setAttribute('data-url', res.url);
                        imgThumb.innerHTML = `
                            <a href="${res.url}" target="_blank">
                                <img src="${res.url}" alt="Evidence" class="evidence-thumb-img" />
                            </a>
                            <span class="remove-thumb-btn" onclick="this.parentElement.remove()">✕</span>
                        `;
                        container.appendChild(imgThumb);
                    }
                } else {
                    alert("Upload failed: " + res.message);
                }
            } catch (err) {
                console.error("Error uploading evidence photo:", err);
                alert("Photo upload error!");
            }
        }

        function setScore(btn, itemId, score) {
            var parent = btn.parentElement;
            parent.querySelectorAll('.score-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            calculateChecksheetProgress();
        }

        function closeUnansweredModal() {
            document.getElementById('modalUnansweredWarning').classList.remove('active');
        }

        function closeUnansweredModalAndScroll() {
            closeUnansweredModal();
            var itemRows = document.querySelectorAll('#conductChecksheetBody tr[data-item-id]');
            for (var i = 0; i < itemRows.length; i++) {
                if (!itemRows[i].querySelector('.score-btn.selected')) {
                    itemRows[i].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    break;
                }
            }
        }

        async function submitConductForm(actionType) {
            var sessionId = parseInt(document.getElementById('conductSessionSelect').value);
            if (sessionId <= 0) {
                alert("Please select an active audit session first!");
                return;
            }

            var itemRows = document.querySelectorAll('#conductChecksheetBody tr[data-item-id]');
            var items = [];
            var unansweredItems = [];

            itemRows.forEach(row => {
                var itemId = parseInt(row.getAttribute('data-item-id'));
                var selectedBtn = row.querySelector('.score-btn.selected');
                var noteInput = row.querySelector('.item-note');

                if (selectedBtn) {
                    var score = parseFloat(selectedBtn.textContent.trim());
                    items.push({
                        auditItemId: itemId,
                        score: score,
                        judge: score >= 6 ? 'PASS' : 'FAIL',
                        note: noteInput ? noteInput.value : ''
                    });
                    row.style.outline = "none";
                } else {
                    var seqText = row.querySelector('td:first-child')?.textContent?.trim() || ('#' + itemId);
                    unansweredItems.push(seqText);
                    row.style.outline = "2px solid #dc2626";
                    row.style.borderRadius = "8px";
                }
            });

            // Bilingual Modal Rule: Block submit if any items are left blank
            if (actionType !== 'draft' && unansweredItems.length > 0) {
                document.getElementById('unansweredItemsText').textContent = unansweredItems.join(', ');
                document.getElementById('modalUnansweredWarning').classList.add('active');
                return;
            }

            var res = await fetch(`/api/audit/sessions/${sessionId}/conduct`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: sessionId,
                    action: actionType,
                    items: items
                })
            }).then(r => r.json());

            if (res.success) {
                alert(`Audit evaluation saved! Total Score: ${res.scorePercent}% (Grade ${res.grade})`);
                loadConductChecksheet();
            } else {
                alert("Error: " + res.message);
            }
        }

        async function loadIssueList() {
            var statusId = document.getElementById('issueStatusFilter').value;
            var deptId = document.getElementById('issueDeptFilter').value;

            var res = await fetch(`/api/audit/actions?statusId=${statusId}&deptId=${deptId}`).then(r => r.json());
            if (!res.success) return;

            var rows = res.data.map(a => `
                <tr>
                    <td><strong>#${a.id}</strong></td>
                    <td><span class="status-badge status-submitted">${a.deptName || 'N/A'}</span></td>
                    <td>${a.category || 'General'}</td>
                    <td>${a.description || ''}</td>
                    <td>${a.picName || 'Unassigned'}</td>
                    <td>${a.dueDate ? a.dueDate.split('T')[0] : 'N/A'}</td>
                    <td><span class="status-badge status-${(a.statusName || 'open').toLowerCase()}">${a.statusName || 'Open'}</span></td>
                    <td>📸 ${a.evidences ? a.evidences.length : 0} photos</td>
                    <td>
                        <button type="button" class="score-btn s8" style="width:auto; padding:0 8px;" onclick="closeIssueAction(${a.id})">Close Issue</button>
                    </td>
                </tr>
            `).join('');

            document.getElementById('issueTableBody').innerHTML = rows || '<tr><td colspan="9" style="text-align:center;">No audit CAPA issues found.</td></tr>';
        }

        async function closeIssueAction(actionId) {
            if (!confirm("Are you sure you want to mark this CAPA issue as Closed?")) return;

            var res = await fetch(`/api/audit/actions/${actionId}/status`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ actionId: actionId, statusId: 9 }) // 9 = Closed
            }).then(r => r.json());

            if (res.success) {
                loadIssueList();
            }
        }

        async function createNCForResult(sessionId, itemId) {
            var desc = prompt("Enter Description of Non-Conformance / Issue:");
            if (!desc) return;

            var res = await fetch('/api/audit/actions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    auditResultId: itemId,
                    description: desc
                })
            }).then(r => r.json());

            if (res.success) {
                alert("NC Issue created successfully!");
            }
        }

        async function loadSummaryMetrics() {
            var res = await fetch('/api/audit/summary').then(r => r.json());
            if (!res.success) return;

            var d = res.data;
            document.getElementById('kpiTotalRounds').textContent = d.totalSessions;
            document.getElementById('kpiAvgScore').textContent = d.averageScorePercent + '%';
            document.getElementById('kpiTotalIssues').textContent = d.totalIssues;
            document.getElementById('kpiOpenIssues').textContent = d.openIssues;

            // Render Charts
            var deptNames = d.departmentPerformance.map(p => p.deptName);
            var deptScores = d.departmentPerformance.map(p => p.avgScorePercent);

            if (deptScoreChart) deptScoreChart.destroy();
            var ctx1 = document.getElementById('chartDeptScore').getContext('2d');
            deptScoreChart = new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: deptNames.length ? deptNames : ['Warehouse'],
                    datasets: [{
                        label: 'Average Score %',
                        data: deptScores.length ? deptScores : [100],
                        backgroundColor: '#2563eb'
                    }]
                }
            });

            if (issueStatusChart) issueStatusChart.destroy();
            var ctx2 = document.getElementById('chartIssueStatus').getContext('2d');
            issueStatusChart = new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Open', 'Rectified', 'Closed'],
                    datasets: [{
                        data: [d.openIssues, d.rectifiedIssues, d.closedIssues],
                        backgroundColor: ['#dc2626', '#f59e0b', '#10b981']
                    }]
                }
            });
        }
    </script>
    <script src="~/js/theme-clock.js" asp-append-version="true"></script>
</body>
</html>
