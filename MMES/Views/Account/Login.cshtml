@model MMES.Models.AccountPageViewModel
@{
    Layout = null;
    var activeTab = ViewData["ActiveTab"] as string ?? "login";
    var registerSuccess = ViewData["RegisterSuccess"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - MMES</title>
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MEX-MES 3.0" />
    <link rel="apple-touch-icon" href="~/images/Logo.png" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="account-page">
    <div class="auth-container">
        <section class="auth-card">
            <div class="auth-header">
                <img src="~/images/Logo.png" alt="MEX-MES Logo" class="auth-logo" onerror="this.style.display='none'" />
                <h1 class="auth-title">MEX-MES 3.0</h1>
                <p class="auth-subtitle">Manufacturing Execution System</p>
            </div>

            <form class="account-form @(activeTab == "login" ? "is-active" : "")" id="form-login" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" aria-label="Sign in form">
                <div class="field">
                    <label for="login-id">Employee ID</label>
                    <div class="input-wrap">
                        <input id="login-id" name="EmployeeId" type="text" placeholder="Ej. HS-00231" value="@Model.Login.EmployeeId" autocomplete="username" required>
                    </div>
                </div>

                <div class="field">
                    <label for="login-password">Password</label>
                    <div class="input-wrap">
                        <input id="login-password" name="Password" type="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required>
                        <button type="button" class="eye" data-target="login-password" aria-pressed="false" aria-label="Show password">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z"/><circle cx="12" cy="12" r="3.2"/></svg>
                        </button>
                    </div>
                </div>

                <div class="row-between">
                    <label class="checkbox">
                        <input type="checkbox" name="RememberMe" value="true" checked="@(Model.Login.RememberMe ? "checked" : null)">
                        <input type="hidden" name="RememberMe" value="false">
                        <span>Remember me</span>
                    </label>
                    <a class="link" href="#">Forgot password?</a>
                </div>

                <button class="submit" type="submit">Sign In</button>
                <p class="form-note @((!ViewContext.ViewData.ModelState.IsValid && activeTab == "login") || !string.IsNullOrEmpty(registerSuccess) ? "has-message" : "") @(!ViewContext.ViewData.ModelState.IsValid && activeTab == "login" ? "error" : "")">
                    @if (!ViewContext.ViewData.ModelState.IsValid && activeTab == "login")
                    {
                        @string.Join(" ", ViewContext.ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
                    }
                    else if (!string.IsNullOrEmpty(registerSuccess))
                    {
                        @registerSuccess
                    }
                </p>
            </form>

            <form class="account-form @(activeTab == "register" ? "is-active" : "")" id="form-register" asp-controller="Account" asp-action="Register" method="post" aria-label="Register form">
                <div class="field">
                    <label for="reg-name">Full Name</label>
                    <div class="input-wrap">
                        <input id="reg-name" name="FullName" type="text" placeholder="Juan Pérez García" value="@Model.Register.FullName" autocomplete="name" required>
                    </div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="reg-id">Employee ID</label>
                        <div class="input-wrap">
                            <input id="reg-id" name="EmployeeId" type="text" placeholder="Ej. HS-00231" value="@Model.Register.EmployeeId" required>
                        </div>
                        @if (ViewContext.ViewData.ModelState["EmployeeId"]?.Errors.Count > 0)
                        {
                            <span class="field-error">@ViewContext.ViewData.ModelState["EmployeeId"]!.Errors.First().ErrorMessage</span>
                        }
                    </div>
                    <div class="field">
                        <label for="reg-dept">Department</label>
                        <div class="input-wrap">
                            <select id="reg-dept" name="DeptId" data-selected="@(Model.Register.DeptId > 0 ? Model.Register.DeptId.ToString() : "")" required>
                                <option value="" selected disabled>Select a department</option>
                            </select>
                            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                        @if (ViewContext.ViewData.ModelState["DeptId"]?.Errors.Count > 0)
                        {
                            <span class="field-error">@ViewContext.ViewData.ModelState["DeptId"]!.Errors.First().ErrorMessage</span>
                        }
                    </div>
                </div>

                <div class="field">
                    <label for="reg-email">Company Email</label>
                    <div class="input-wrap">
                        <input id="reg-email" name="Email" type="email" placeholder="nombre.apellido@haengsung.com" value="@Model.Register.Email" autocomplete="email" required>
                    </div>
                    @if (ViewContext.ViewData.ModelState["Email"]?.Errors.Count > 0)
                    {
                        <span class="field-error">@ViewContext.ViewData.ModelState["Email"]!.Errors.First().ErrorMessage</span>
                    }
                </div>

                <div class="field-row">
                    <div class="field">
                        <label for="reg-password">Password</label>
                        <div class="input-wrap">
                            <input id="reg-password" name="Password" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" required minlength="8">
                            <button type="button" class="eye" data-target="reg-password" aria-pressed="false" aria-label="Show password">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z"/><circle cx="12" cy="12" r="3.2"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="field">
                        <label for="reg-password2">Confirm Password</label>
                        <div class="input-wrap">
                            <input id="reg-password2" name="ConfirmPassword" type="password" placeholder="Repite tu contraseña" autocomplete="new-password" required minlength="8">
                        </div>
                    </div>
                </div>

                <label class="checkbox consent">
                    <input type="checkbox" name="Consent" value="true" required>
                    <input type="hidden" name="Consent" value="false">
                    <span>I agree to HAENG SUNG's internal system usage policy.</span>
                </label>

                <button class="submit" type="submit">Create Account</button>
                <p class="form-note @(!ViewContext.ViewData.ModelState.IsValid && activeTab == "register" ? "has-message error" : "")">
                    @if (!ViewContext.ViewData.ModelState.IsValid && activeTab == "register")
                    {
                        @string.Join(" ", ViewContext.ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
                    }
                </p>
            </form>

            <div class="auth-footer">
                <button type="button" class="mode-toggle" id="mode-toggle">
                    @if (activeTab == "register")
                    {
                        <text>Already have an account? <strong>Sign In</strong></text>
                    }
                    else
                    {
                        <text>Don't have an account? <strong>Register</strong></text>
                    }
                </button>
            </div>
        </section>
    </div>

    <script src="~/js/account.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration failed:', err));
            });
        }
    </script>
</body>
</html>
