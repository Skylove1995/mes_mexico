@model IEnumerable<MMES.Models.StoredFile>
@{
    ViewData["Title"] = "Lưu Trữ File Hệ Thống";
    Layout = null;
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trung Tâm Lưu Trữ File - HAENG SUNG MEX-MES 3.0</title>
    <!-- Tailwind CSS v3 via CDN -->
    <script>
        (function() {
            var w = console.warn;
            console.warn = function() {
                if (arguments[0] && typeof arguments[0] === 'string' && arguments[0].indexOf('cdn.tailwindcss.com') !== -1) return;
                w.apply(console, arguments);
            };
        })();
    </script>
    <script src="~/js/tailwind-runtime.js" asp-append-version="true"></script>
    <link href="~/css/fontawesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .glass-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(51, 65, 85, 0.6);
        }
        .dropzone-active {
            border-color: #3b82f6 !important;
            background-color: rgba(59, 130, 246, 0.1) !important;
        }
    </style>
</head>
<body class="bg-[#0B0F17] text-slate-100 font-sans antialiased min-h-screen pb-12">
    
    <!-- Top Bar Navigation -->
    <header class="bg-slate-900/90 border-b border-slate-800 backdrop-blur sticky top-0 z-50 px-6 py-4 flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-4">
            <a href="/" class="flex items-center gap-3 text-cyan-400 font-bold text-xl hover:text-cyan-300 transition-colors">
                <div class="p-2 bg-cyan-500/10 border border-cyan-500/30 rounded-lg">
                    <i class="fa-solid fa-server text-cyan-400"></i>
                </div>
                <span>MEX-MES 3.0</span>
            </a>
            <span class="text-slate-600">/</span>
            <span class="text-slate-300 font-medium">Trung Tâm Lưu Trữ File</span>
        </div>
        <div class="flex items-center gap-3 text-sm text-slate-400">
            <span class="px-3 py-1 bg-slate-800 rounded-full border border-slate-700">
                <i class="fa-solid fa-hard-drive text-emerald-400 mr-1.5"></i> Local Server Storage
            </span>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">

        <!-- TempData Notification Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 flex items-center justify-between shadow-lg">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-check text-xl"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 p-4 bg-rose-500/10 border border-rose-500/30 rounded-xl text-rose-400 flex items-center justify-between shadow-lg">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        }

        <!-- Page Header & Stats -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
                    <i class="fa-solid fa-cloud-arrow-up text-cyan-400"></i> Quản Lý & Tải File Hệ Thống
                </h1>
                <p class="text-slate-400 mt-1 text-sm">Upload file từ client để lưu trữ local trên server và chia sẻ cho tất cả người dùng trong hệ thống.</p>
            </div>
            
            @{
                var totalFiles = Model?.Count() ?? 0;
                var totalSize = Model?.Sum(f => f.FileSize) ?? 0;
                string formattedSize = totalSize switch {
                    >= 1073741824 => $"{totalSize / 1073741824.0:F2} GB",
                    >= 1048576 => $"{totalSize / 1048576.0:F2} MB",
                    >= 1024 => $"{totalSize / 1024.0:F2} KB",
                    _ => $"{totalSize} B"
                };
            }

            <div class="flex items-center gap-3">
                <div class="glass-card px-4 py-2.5 rounded-xl flex items-center gap-3">
                    <div class="p-2 bg-blue-500/10 text-blue-400 rounded-lg">
                        <i class="fa-solid fa-files"></i>
                    </div>
                    <div>
                        <div class="text-xs text-slate-400">Tổng Số File</div>
                        <div class="text-lg font-bold text-white">@totalFiles</div>
                    </div>
                </div>
                <div class="glass-card px-4 py-2.5 rounded-xl flex items-center gap-3">
                    <div class="p-2 bg-purple-500/10 text-purple-400 rounded-lg">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <div>
                        <div class="text-xs text-slate-400">Dung Lượng Sử Dụng</div>
                        <div class="text-lg font-bold text-white">@formattedSize</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upload File Section (Drag & Drop Zone) -->
        <div class="glass-card rounded-2xl p-6 mb-8 border border-slate-800 shadow-xl">
            <h2 class="text-lg font-semibold text-slate-200 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-upload text-blue-400"></i> Tải File Lên Máy Chủ
            </h2>

            <form asp-controller="FileStorage" asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                @Html.AntiForgeryToken()

                <div id="dropZone" class="border-2 border-dashed border-slate-700 hover:border-cyan-500/50 bg-slate-900/50 rounded-xl p-8 text-center cursor-pointer transition-all">
                    <input type="file" name="file" id="fileInput" class="hidden" onchange="handleFileSelect(this.files)" />

                    <div id="dropZoneContent" class="space-y-3">
                        <div class="w-16 h-16 bg-cyan-500/10 text-cyan-400 rounded-full flex items-center justify-center mx-auto border border-cyan-500/20 text-2xl shadow-inner">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        <div>
                            <p class="text-base font-medium text-slate-200">Kéo và thả file vào đây, hoặc <span class="text-cyan-400 underline cursor-pointer hover:text-cyan-300">Chọn file từ máy tính</span></p>
                            <p class="text-xs text-slate-500 mt-1">Hỗ trợ các định dạng: .PDF, .DOCX, .XLSX, .PNG, .JPG, .ZIP, .RAR, .CSV, .TXT (Tối đa 50MB)</p>
                        </div>
                    </div>

                    <!-- File Selected Info (Hidden by default) -->
                    <div id="fileSelectedInfo" class="hidden flex items-center justify-between bg-slate-800/80 p-4 rounded-xl border border-slate-700">
                        <div class="flex items-center gap-3">
                            <i id="fileIcon" class="fa-solid fa-file text-cyan-400 text-2xl"></i>
                            <div class="text-left">
                                <p id="fileName" class="font-medium text-slate-200 text-sm truncate max-w-xs md:max-w-md"></p>
                                <p id="fileSize" class="text-xs text-slate-400"></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="button" onclick="cancelFileSelect()" class="px-3 py-1.5 text-xs text-slate-400 hover:text-slate-200 hover:bg-slate-700 rounded-lg transition-colors">
                                Hủy chọn
                            </button>
                            <button type="submit" class="px-5 py-2 text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg shadow-lg shadow-cyan-600/30 transition-all flex items-center gap-2">
                                <i class="fa-solid fa-upload"></i> Bắt đầu Upload
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- File List Table Section -->
        <div class="glass-card rounded-2xl border border-slate-800 shadow-xl overflow-hidden">
            <!-- Filter & Search Bar -->
            <div class="p-5 bg-slate-900/60 border-b border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <h2 class="text-lg font-semibold text-slate-200 flex items-center gap-2">
                    <i class="fa-solid fa-folder-open text-amber-400"></i> Danh Sách File Đã Tải Lên
                </h2>
                
                <div class="flex items-center gap-3">
                    <!-- Search Input -->
                    <div class="relative w-full md:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                        <input type="text" id="searchInput" onkeyup="filterFiles()" placeholder="Tìm kiếm tên file, người upload..." 
                               class="w-full pl-9 pr-4 py-2 bg-slate-800/80 border border-slate-700 rounded-xl text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 transition-colors" />
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-900/80 text-xs uppercase text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Tên File</th>
                            <th class="px-6 py-4 font-semibold">Dung Lượng</th>
                            <th class="px-6 py-4 font-semibold">Người Upload</th>
                            <th class="px-6 py-4 font-semibold">Thời Gian</th>
                            <th class="px-6 py-4 font-semibold text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60" id="fileTableBody">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                                    <i class="fa-solid fa-folder-open text-4xl mb-3 block opacity-40"></i>
                                    Chưa có file nào được tải lên hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                string ext = System.IO.Path.GetExtension(item.OriginalFileName)?.ToLower() ?? "";
                                string iconClass = ext switch {
                                    ".pdf" => "fa-file-pdf text-rose-400",
                                    ".doc" or ".docx" => "fa-file-word text-blue-400",
                                    ".xls" or ".xlsx" or ".csv" => "fa-file-excel text-emerald-400",
                                    ".png" or ".jpg" or ".jpeg" or ".gif" => "fa-file-image text-purple-400",
                                    ".zip" or ".rar" or ".7z" => "fa-file-zipper text-amber-400",
                                    ".txt" or ".json" or ".xml" => "fa-file-lines text-slate-400",
                                    _ => "fa-file text-cyan-400"
                                };

                                string sizeStr = item.FileSize switch {
                                    >= 1048576 => $"{item.FileSize / 1048576.0:F2} MB",
                                    >= 1024 => $"{item.FileSize / 1024.0:F2} KB",
                                    _ => $"{item.FileSize} B"
                                };

                                <tr class="hover:bg-slate-800/40 transition-colors file-row" data-name="@item.OriginalFileName.ToLower()" data-uploader="@((item.UploadedBy ?? "").ToLower())">
                                    <td class="px-6 py-4 font-medium text-slate-200">
                                        <div class="flex items-center gap-3">
                                            <div class="p-2 bg-slate-800 rounded-lg text-lg flex-shrink-0">
                                                <i class="fa-solid @iconClass"></i>
                                            </div>
                                            <span class="truncate max-w-xs md:max-w-md" title="@item.OriginalFileName">@item.OriginalFileName</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-400 whitespace-nowrap">
                                        <span class="px-2.5 py-1 bg-slate-800 rounded-md text-xs font-mono border border-slate-700/60">@sizeStr</span>
                                    </td>
                                    <td class="px-6 py-4 text-slate-300 whitespace-nowrap">
                                        <div class="flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs flex items-center justify-center font-bold">
                                                @((item.UploadedBy ?? "A").Substring(0, 1).ToUpper())
                                            </div>
                                            <span>@(item.UploadedBy ?? "System")</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-400 text-xs whitespace-nowrap">
                                        <i class="fa-regular fa-clock mr-1 opacity-70"></i> @item.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="px-6 py-4 text-right whitespace-nowrap">
                                        <div class="flex items-center justify-end gap-2">
                                            <a asp-controller="FileStorage" asp-action="Download" asp-route-id="@item.Id" 
                                               class="px-3 py-1.5 bg-cyan-600/20 border border-cyan-500/40 text-cyan-300 hover:bg-cyan-600 hover:text-white rounded-lg text-xs font-medium transition-all flex items-center gap-1.5 shadow-sm">
                                                <i class="fa-solid fa-download"></i> Tải về
                                            </a>
                                            <form asp-controller="FileStorage" asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa file này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-1.5 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors" title="Xóa file">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const dropZoneContent = document.getElementById('dropZoneContent');
        const fileSelectedInfo = document.getElementById('fileSelectedInfo');
        const fileName = document.getElementById('fileName');
        const fileSize = document.getElementById('fileSize');

        dropZone.addEventListener('click', (e) => {
            if (e.target.closest('button')) return;
            fileInput.click();
        });

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.add('dropzone-active'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => dropZone.classList.remove('dropzone-active'), false);
        });

        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            const files = dt.files;
            if (files.length > 0) {
                fileInput.files = files;
                handleFileSelect(files);
            }
        });

        function handleFileSelect(files) {
            if (!files || files.length === 0) return;
            const file = files[0];
            fileName.textContent = file.name;
            
            let size = file.size;
            let sizeFormatted = size >= 1048576 
                ? (size / 1048576).toFixed(2) + ' MB' 
                : (size / 1024).toFixed(2) + ' KB';
            fileSize.textContent = sizeFormatted;

            dropZoneContent.classList.add('hidden');
            fileSelectedInfo.classList.remove('hidden');
        }

        function cancelFileSelect() {
            fileInput.value = '';
            dropZoneContent.classList.remove('hidden');
            fileSelectedInfo.classList.add('hidden');
        }

        function filterFiles() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.file-row');

            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const uploader = row.getAttribute('data-uploader') || '';
                if (name.includes(input) || uploader.includes(input)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
