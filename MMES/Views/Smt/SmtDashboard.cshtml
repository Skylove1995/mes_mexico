            const avgPl = pickupLossData.length > 0 ? (pickupLossData.reduce((acc, val) => acc + val.pickupLoss, 0) / pickupLossData.length) : 0;
            
            const goEl=document.getElementById('g_total_output'),gpEl=document.getElementById('g_pass_rate'),glEl=document.getElementById('g_pickup_loss'),giEl=document.getElementById('g_idle_time');
            if(goEl) {
                const targetVal = (globalSummaryData && globalSummaryData.totalTargetInputPlan > 0) ? globalSummaryData.totalTargetInputPlan : 0;
                const formattedOut = (out / 1000).toFixed(2) + 'K';
                if (targetVal > 0) {
                    const pct = (out / targetVal) * 100;
                    goEl.innerHTML = `${formattedOut}<br/><span style="font-size: 0.55em; font-weight: 500; opacity: 0.85; display: block; line-height: 1.1; margin-top: 2px;">(${pct.toFixed(1)}<span class="pct-sign">%</span>)</span>`;
                } else {
                    goEl.innerHTML = `${formattedOut}<br/><span style="font-size: 0.55em; font-weight: 500; opacity: 0.85; display: block; line-height: 1.1; margin-top: 2px;">(0.0<span class="pct-sign">%</span>)</span>`;
                }
            }
            if(gpEl){
                gpEl.innerHTML = pr.toFixed(2) + '<span class="pct-sign">%</span>';
            }
            const gyEl = document.getElementById('g_yield_rate');
            if(gyEl){
                gyEl.innerHTML = pr.toFixed(1) + '<span class="pct-sign">%</span>';
            }
            if(glEl) {
                glEl.innerHTML = avgPl.toFixed(2) + '<span class="pct-sign">%</span>';
            }
            if(giEl) {
                giEl.textContent=idle.toFixed(1);
            }
            
            // Calculate SPI and MOI average pass rates
            let spiAcc = 0, spiIn = 0;
            let moiAcc = 0, moiIn = 0;
            const spiAgg = getProcessPassRateByLine('spi');
            const moiAgg = getProcessPassRateByLine('moi');
            spiAgg.forEach(a => { spiAcc += a.totalOut; spiIn += a.totalIn; });
            moiAgg.forEach(a => { moiAcc += a.totalOut; moiIn += a.totalIn; });
            const spiRate = spiIn > 0 ? (spiAcc / spiIn * 100).toFixed(2) + '%' : '—';
            const moiRate = moiIn > 0 ? (moiAcc / moiIn * 100).toFixed(2) + '%' : '—';
            
            const spiEl = document.getElementById('g_spi_rate');
            const moiEl = document.getElementById('g_moi_rate');
            if (spiEl) spiEl.innerHTML = spiRate.replace('%', '<span class="pct-sign">%</span>');
            if (moiEl) moiEl.innerHTML = moiRate.replace('%', '<span class="pct-sign">%</span>');

            renderOutputHoverPanel();
            renderOeeHoverPanel();
            renderPickupHoverPanel();
        }

