        function parseUphDictExcelInput() {
            const rawText = (document.getElementById('uphDictExcelInput').value || '').trim();
            if (!rawText) return [];
            
            const lines = rawText.split('\n');
            const items = [];
            lines.forEach((lineStr, idx) => {
                const cleanLine = lineStr.trim();
                if (!cleanLine) return;
                
                let parts = cleanLine.split('\t');
                if (parts.length < 2) parts = cleanLine.split(',');
                if (parts.length < 2) parts = cleanLine.split(';');

                // Skip Header row if detected (e.g. Line, Lane, EBR, UPH)
                if (idx === 0 || parts[0].toLowerCase().includes('line')) {
                    const lineCol = parts[0].trim().toLowerCase();
                    const lastCol = parts[parts.length - 1].trim().toLowerCase();
                    if (lineCol === 'line' || lastCol.includes('uph') || lastCol.includes('target')) {
                        return; // Skip header line
                    }
                }

                if (parts.length >= 2) {
                    let lineVal = parts[0].trim();
                    let laneVal = 'L1';
                    let smtPnVal = 'ALL';
                    let uphVal = null;

                    if (parts.length >= 4) {
                        laneVal = parts[1].trim();
                        smtPnVal = parts[2].trim() || 'ALL';
                        uphVal = parseInt(parts[3].trim(), 10);
                    } else if (parts.length === 3) {
                        const thirdVal = parseInt(parts[2].trim(), 10);
                        if (!isNaN(thirdVal)) {
                            laneVal = parts[1].trim();
                            smtPnVal = 'ALL';
                            uphVal = thirdVal;
                        } else {
                            laneVal = parts[1].trim();
                            smtPnVal = parts[2].trim() || 'ALL';
                        }
                    } else if (parts.length === 2) {
                        uphVal = parseInt(parts[1].trim(), 10);
                    }

                    if (lineVal && !isNaN(uphVal)) {
                        items.push({
                            line: lineVal,
                            lane: laneVal,
                            smtPn: smtPnVal,
                            uph: uphVal
                        });
                    }
                }
            });
            return items;
        }

