        async function loadHistoryTrends(isRefresh = false) {
            try {
                const resTrends = await smtFetch('/api/SmtApi/dashboard/history-trends');
                if (resTrends.ok) {
                    const trends = await resTrends.json();
                    if (trends.success) {
                        serverOutput7Days = trends.output7Days || [];
                        if (serverOutput7Days.length > 0) {
                            const todayItem = serverOutput7Days[serverOutput7Days.length - 1];
                            if (!globalSummaryData) globalSummaryData = {};
                            globalSummaryData.totalTargetInputPlan = todayItem.target || 0;
                            updateGlobalSummaries();
                        }
                        serverUpph7Days = trends.upph7Days || [];
                        serverPickupLoss7Days = trends.pickupLoss7Days || [];
                        serverIdleTime7Days = trends.idleTime7Days || [];
                        serverDefect7Days = trends.defect7Days || [];
                        serverOee7Days = trends.oee7Days || [];
                    }
                }

                if (!isRefresh) {
                    initTrendCharts();
                    initPickupLossChart();
                    initIdleTimeChart();
                } else {
                    updateTrendCharts();
                    if (pickupLossChart) {
                        updatePickupLossChart();
                    } else {
                        initPickupLossChart();
                    }
                    if (idleTimeChart) {
                        updateIdleTimeChart();
                    } else {
                        initIdleTimeChart();
                    }
                }
            } catch(err){ console.error('History trends load error:', err); }
        }

        async function loadDashboardData(isRefresh = false) {
            await loadDashboardViewMode();
