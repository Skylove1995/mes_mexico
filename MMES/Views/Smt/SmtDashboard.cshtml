        let allSmtTargets = [];

        const presetMetricsList = [
            { name: "SPI PASS RATE", unit: "%", compare: ">=", period: "Monthly" },
            { name: "MOI PASS RATE", unit: "%", compare: ">=", period: "Monthly" },
            { name: "AOI PASS RATE", unit: "%", compare: ">=", period: "Monthly" },
            { name: "OEE", unit: "%", compare: ">=", period: "Daily" },
            { name: "PICKUP LOSS", unit: "%", compare: "<=", period: "Monthly" },
            { name: "YIELD RATE", unit: "%", compare: ">=", period: "Monthly" },
            { name: "UPPH", unit: "pcs/man-h", compare: ">=", period: "Shift" },
            { name: "DEFECT TREND", unit: "pcs", compare: "<=", period: "Monthly" }
        ];

        let currentDashboardViewMode = 'HSE';
        let isUserAdminForViewMode = false;

        async function loadDashboardViewMode() {
            try {
                const res = await smtFetch('/api/SmtApi/dashboard/view-mode');
                if (res.ok) {
                    const data = await res.json();
                    if (data) {
                        isUserAdminForViewMode = !!data.isAdmin;
                        if (data.viewMode) {
                            currentDashboardViewMode = data.viewMode.toUpperCase();
                        }
                        updateViewModeUI(currentDashboardViewMode);
                    }
                }
            } catch (err) {
                console.error('Lỗi khi tải View Mode:', err);
            }
        }

        async function setDashboardViewMode(mode) {
            if (!isUserAdminForViewMode) {
                alert('Chỉ tài khoản có quyền Admin (isAdmin = true) mới được thay đổi View Mode!');
                return;
            }

            const targetMode = (mode || 'HSE').toUpperCase();
            if (targetMode === currentDashboardViewMode) return;

            currentDashboardViewMode = targetMode;
            updateViewModeUI(targetMode);

            try {
                const res = await smtFetch('/api/SmtApi/dashboard/view-mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ viewMode: targetMode })
                });
                if (res.ok) {
                    const data = await res.json();
                    console.log('Saved View Mode globally:', data);
                    loadDashboardData(true);
                } else {
                    const errData = await res.json();
                    alert(errData.message || 'Lỗi khi lưu View Mode.');
                    loadDashboardViewMode();
                }
            } catch (err) {
                console.error('Lỗi khi lưu View Mode:', err);
                loadDashboardViewMode();
            }
        }

        function updateViewModeUI(mode) {
            const btnHse = document.getElementById('btnViewModeHse');
            const btnCustomer = document.getElementById('btnViewModeCustomer');
            const hudBadge = document.getElementById('hudViewModeBadge');
            const hudIcon = document.getElementById('hudViewModeIcon');

            if (!isUserAdminForViewMode) {
                if (btnHse) {
                    btnHse.style.cursor = 'not-allowed';
                    btnHse.title = 'Chỉ Admin mới có quyền chuyển đổi View Mode';
                }
                if (btnCustomer) {
                    btnCustomer.style.cursor = 'not-allowed';
                    btnCustomer.title = 'Chỉ Admin mới có quyền chuyển đổi View Mode';
                }
            } else {
                if (btnHse) {
                    btnHse.style.cursor = 'pointer';
                    btnHse.title = 'Chuyển sang HSE Mode (Dữ liệu thực tế)';
                }
                if (btnCustomer) {
                    btnCustomer.style.cursor = 'pointer';
                    btnCustomer.title = 'Chuyển sang CUSTOMER Mode (Dữ liệu trình chiếu khách hàng)';
                }
            }

            const defectPanel = document.getElementById('hud_defect_panel');
            const colRight = document.querySelector('.col-right');

            if (mode === 'CUSTOMER') {
                if (btnHse) btnHse.classList.remove('active');
                if (btnCustomer) btnCustomer.classList.add('active');

                if (hudBadge) {
                    hudBadge.className = 'hud-view-mode-badge customer-mode';
                }
                if (hudIcon) hudIcon.className = 'bi bi-person-badge-fill';
                if (defectPanel) defectPanel.style.display = 'none';
                if (colRight) colRight.style.gridTemplateRows = '22% 37.5% 37.5%';
            } else {
                if (btnHse) btnHse.classList.add('active');
                if (btnCustomer) btnCustomer.classList.remove('active');

                if (hudBadge) {
                    hudBadge.className = 'hud-view-mode-badge hse-mode';
                }
                if (hudIcon) hudIcon.className = 'bi bi-shield-check';
                if (defectPanel) defectPanel.style.display = '';
                if (colRight) colRight.style.gridTemplateRows = '';
            }

            if (defectTrendChart) {
                updateTrendCharts();
            }
        }

