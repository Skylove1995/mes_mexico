    <script>
        Chart.register(ChartDataLabels);

        let linesData = [];
        let pickupLossData = [];
        let top10PickupFeeders = [];
        let idleTimeData = [];
        let defectData = { global: [], byLine: [] };
        let trendsData = [];
        let currentDefectLine = 'ALL';
        let globalSummaryData = null;
        let outputTrendChart, upphTrendChart, defectTrendChart, defectChart, pickupLossChart, idleTimeChart, outputLineChart, spiBarChart, moiBarChart, aoiBarChart;

        function startClock() {
            const el = document.getElementById('hud_clock');
            setInterval(() => {
                const now = new Date();
                const pad = n => String(n).padStart(2,'0');
                el.textContent = `${pad(now.getDate())}/${pad(now.getMonth()+1)}/${now.getFullYear()} - ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
            }, 1000);
        }

        let wismaxGatewaysData = [];

        async function loadWismaxEnvData() {
            try {
                const res = await fetch('/api/wismax/smt-env-data');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        const tempEl = document.getElementById('hud_temp');
                        const humEl = document.getElementById('hud_humidity');
                        if (tempEl && data.temp != null) tempEl.textContent = Number(data.temp).toFixed(1);
                        if (humEl && data.humidity != null) humEl.textContent = Number(data.humidity).toFixed(1);
                        wismaxGatewaysData = data.gateways || [];
                        renderEnvHoverPanel();
                    }
                }
            } catch(err) { console.error('Wismax Env Data load error:', err); }
        }

        function renderEnvHoverPanel() {
            const panel = document.getElementById('envHoverDetailPanel');
            if (!panel) return;

            if (!wismaxGatewaysData || wismaxGatewaysData.length === 0) {
                panel.innerHTML = `
                    <div class="ohp-header" style="color: #38bdf8; border-bottom-color: rgba(56, 189, 248, 0.25);">
                        <span><i class="bi bi-cpu-fill me-1"></i> Chi Tiết SMT Gateways (Wismax DB)</span>
                    </div>
                    <div style="font-size: 0.75rem; color: #94a3b8; text-align: center; padding: 12px;">Đang tải dữ liệu Gateway...</div>`;
                return;
            }

            let html = `
                <div class="ohp-header" style="color: #38bdf8; border-bottom-color: rgba(56, 189, 248, 0.25);">
                    <span><i class="bi bi-cpu-fill me-1"></i> SMT Gateways (${wismaxGatewaysData.length})</span>
                    <span style="font-size: 0.7rem; color: #94a3b8; font-weight: 500;">Wismax DB</span>
                </div>
                <div class="ohp-list">`;

            wismaxGatewaysData.forEach(gw => {
                const temp = gw.temp != null ? Number(gw.temp).toFixed(1) : '--';
                const hum = gw.humidity != null ? Number(gw.humidity).toFixed(1) : '--';
                const nameStr = `${gw.gatewayName} (${gw.gatewayId})`;

                html += `
                    <div class="ohp-row">
                        <div class="ohp-row-header">
                            <span class="ohp-line-title" style="font-size: 0.76rem;">${escapeHtml(nameStr)}</span>
                            <span class="ohp-line-stats">
                                <span style="color:#f43f5e; font-weight:700;"><i class="bi bi-thermometer-half"></i> ${temp}°C</span>
                                <span style="color:rgba(255,255,255,0.3); margin:0 4px;">|</span>
                                <span style="color:#38bdf8; font-weight:700;"><i class="bi bi-droplet-fill"></i> ${hum}%</span>
                            </span>
                        </div>
                    </div>`;
            });

            html += `</div>`;
            panel.innerHTML = html;
        }

        function openTab(tabId, btn) {
            const container = btn.closest('.hud-panel');
            container.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            container.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
        }

        function getTop3DefectLines() {
            if (!defectData.byLine) return [];
            return [...defectData.byLine].sort((a, b) => {
                const sumA = a.defects.reduce((acc, d) => acc + d.count, 0);
                const sumB = b.defects.reduce((acc, d) => acc + d.count, 0);
                return sumB - sumA;
            }).slice(0, 3).map(l => l.lineName);
        }

        function renderDefectTabs() {
            const container = document.getElementById('defectTabsHeader');
            if (!container) return;
            
            let html = `<button class="tab-btn ${currentDefectLine === 'ALL' ? 'active' : ''}" onclick="openDefectTab('ALL')">ALL</button>`;
            if (defectData.byLine) {
                const top3Names = getTop3DefectLines();
                top3Names.forEach(lineName => {
                    const shortName = lineName.replace('Line ', '');
                    const isActive = currentDefectLine === lineName ? 'active' : '';
                    html += `<button class="tab-btn ${isActive}" onclick="openDefectTab('${lineName}')">${shortName}</button>`;
                });
                
                if (defectData.byLine.length > 3) {
                    const isActive = currentDefectLine === 'OTHER' ? 'active' : '';
                    html += `<button class="tab-btn ${isActive}" onclick="openDefectTab('OTHER')">OTHER</button>`;
                }
            }
            container.innerHTML = html;
        }

        function openDefectTab(lineName) {
            currentDefectLine = lineName;
            renderDefectTabs();
            updateDefectChart();
        }

        let serverLineTargets = {};
        let allUphDictTargets = [];

        const SMT_DASHBOARD_SECRET_KEY = 'SMT_HAENGSUNG_SECRET_KEY_2026';

        function smtFetch(url, options = {}) {
            const opts = Object.assign({}, options);
            if (!opts.headers) {
                opts.headers = {};
            }
            if (opts.headers instanceof Headers) {
                opts.headers.append('X-Dashboard-Key', SMT_DASHBOARD_SECRET_KEY);
            } else {
                opts.headers['X-Dashboard-Key'] = SMT_DASHBOARD_SECRET_KEY;
            }
            return fetch(url, opts);
        }

        async function fetchMasterTargets() {
            try {
                const res = await smtFetch('/api/SmtApi/dashboard/targets');
                if (res.ok) {
                    const result = await res.json();
                    if (result && result.success) {
                        allSmtTargets = result.data || [];
                        allUphDictTargets = result.uphDict || [];
                        if (result.lineTargets) {
                            serverLineTargets = result.lineTargets;
                        }
                    }
                }
            } catch(e) { console.error("Failed to fetch master targets:", e); }
        }

        function getUphTargetFromDict(line, lane, smtPn) {
            if (!allUphDictTargets || !Array.isArray(allUphDictTargets) || allUphDictTargets.length === 0) return null;
            let match = null;
            const lineStr = (line || '').trim().toLowerCase();
            const laneStr = (lane || '').trim().toLowerCase();
            const pnStr = (smtPn || '').trim().toLowerCase();

            if (pnStr && pnStr !== 'all') {
                match = allUphDictTargets.find(u => 
                    (u.line && u.line.trim().toLowerCase() === lineStr) &&
                    (!u.lane || u.lane.trim().toLowerCase() === laneStr || u.lane.trim().toLowerCase() === 'all') &&
                    (u.smtPn && u.smtPn.trim().toLowerCase() === pnStr)
                );
            }
            if (!match && laneStr && laneStr !== 'all') {
                match = allUphDictTargets.find(u => 
                    (u.line && u.line.trim().toLowerCase() === lineStr) &&
                    (u.lane && u.lane.trim().toLowerCase() === laneStr)
                );
            }
            if (!match) {
                match = allUphDictTargets.find(u => 
                    (u.line && u.line.trim().toLowerCase() === lineStr)
                );
            }
            return match ? match.uph : null;
        }

        function getMetricTarget(metricName) {
            const targetUpper = (metricName || '').trim().toUpperCase();
            if (targetUpper === "TOTAL OUTPUT" || targetUpper.includes("TOTAL OUTPUT")) {
                let val = (globalSummaryData && globalSummaryData.totalTargetInputPlan != null && globalSummaryData.totalTargetInputPlan > 0)
                    ? globalSummaryData.totalTargetInputPlan
                    : (serverOutput7Days && serverOutput7Days.length > 0 ? (serverOutput7Days[serverOutput7Days.length - 1].target || 0) : 0);

                return {
                    id: 0,
                    targetName: "TOTAL OUTPUT",
                    targetValue: val,
                    targetUnit: "pcs",
                    compareOperator: ">="
                };
            }
            if (!allSmtTargets || !Array.isArray(allSmtTargets) || allSmtTargets.length === 0) return null;
            let found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase() === targetUpper);
            if (!found) {
                if (targetUpper.includes("DEFECT")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("DEFECT"));
                } else if (targetUpper.includes("PICKUP")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("PICKUP"));
                } else if (targetUpper.includes("SPI")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("SPI"));
                } else if (targetUpper.includes("MOI")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("MOI"));
                } else if (targetUpper.includes("AOI")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("AOI"));
                } else if (targetUpper.includes("YIELD")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("YIELD"));
                } else if (targetUpper.includes("UPPH")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase().includes("UPPH"));
                } else if (targetUpper.includes("UPH")) {
                    found = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase() === "UPH" || (t.targetName && t.targetName.trim().toUpperCase().includes("UPH") && !t.targetName.trim().toUpperCase().includes("UPPH")));
                }
            }
            return found || null;
        }

        function getTargetValueForMonth(metricName, year, month) {
            if (!allSmtTargets || !Array.isArray(allSmtTargets) || allSmtTargets.length === 0) return null;
            const monthPadded = month < 10 ? '0' + month : '' + month;
            const subKey = `${year}_M${monthPadded}`;
            
            const masterObj = getMetricTarget(metricName);
            if (!masterObj) return null;
            const baseName = masterObj.targetName;
            
            const detailObj = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase() === `${baseName}_${subKey}`.toUpperCase());
            if (detailObj && detailObj.targetValue != null && detailObj.targetValue !== undefined) {
                return detailObj.targetValue;
            }
            
            return masterObj.targetValue != null ? masterObj.targetValue : null;
        }

        function getTargetValueForDay(metricName, year, month, day) {
            if (!allSmtTargets || !Array.isArray(allSmtTargets) || allSmtTargets.length === 0) return null;
            const monthPadded = month < 10 ? '0' + month : '' + month;
            const dayPadded = day < 10 ? '0' + day : '' + day;
            const subKey = `${year}${monthPadded}_D${dayPadded}`;
            
            const masterObj = getMetricTarget(metricName);
            if (!masterObj) return null;
            const baseName = masterObj.targetName;
            
            const detailObj = allSmtTargets.find(t => t.targetName && t.targetName.trim().toUpperCase() === `${baseName}_${subKey}`.toUpperCase());
            if (detailObj && detailObj.targetValue != null && detailObj.targetValue !== undefined) {
                return detailObj.targetValue;
            }
            
            const monthTarget = getTargetValueForMonth(metricName, year, month);
            if (monthTarget != null) return monthTarget;
            
            return masterObj.targetValue != null ? masterObj.targetValue : null;
        }

        function renderTargetBadge(metricName, prefix = "Target ", defaultUnit = "") {
            const obj = getMetricTarget(metricName);
            if (obj && obj.targetValue != null && obj.targetValue !== undefined) {
                const val = obj.targetValue;
                const unit = obj.targetUnit || defaultUnit;
                let formattedVal = val;
                if (typeof val === 'number') {
                    formattedVal = val >= 1000 ? (val / 1000).toFixed(1) + 'K' : formatNumber(val);
                }
                return `${prefix}${formattedVal}${unit}`;
            }
            if (metricName && metricName.toUpperCase().includes("PICKUP")) {
                return `Limit < 0.50%`;
            }
            if (metricName && (metricName.toUpperCase().includes("SPI") || metricName.toUpperCase().includes("MOI") || metricName.toUpperCase().includes("AOI"))) {
                return `Target > 95%`;
            }
            return `<span style="color: #ef4444; font-weight: 700; text-shadow: 0 0 6px rgba(239, 68, 68, 0.4);">Not Setup</span>`;
        }

