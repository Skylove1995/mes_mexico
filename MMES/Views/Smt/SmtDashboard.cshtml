            await Promise.all([
                loadProductionKpi(isRefresh),
                loadOeeKpi(isRefresh),
                loadPickupLossKpi(isRefresh),
                loadHistoryTrends(isRefresh)
            ]);
        }

        const targetLinePlugin = {
            id: 'targetLine',
            afterDatasetsDraw(chart, args, options) {
                const {ctx, chartArea:{top, bottom, left, right}, scales} = chart;
                if(options.value === undefined || options.value === null || isNaN(options.value)) return;
                
                const axis = options.axis || 'y';
                ctx.save();
                ctx.strokeStyle = options.color||'#ef4444';
                ctx.lineWidth = options.lineWidth||2.5;
                ctx.setLineDash(options.borderDash!==undefined ? options.borderDash : []);
                ctx.beginPath();
                
                const label = options.label !== undefined ? options.label : `Target: ${options.value}`;
                
                if (axis === 'y') {
                    const yPos = scales.y.getPixelForValue(options.value);
                    if (yPos >= top - 2 && yPos <= bottom + 2) {
                        ctx.moveTo(left, yPos); ctx.lineTo(right, yPos); ctx.stroke();
                        ctx.fillStyle='rgba(255,255,255,0.85)'; ctx.font='bold 11px Inter'; ctx.textAlign='right'; ctx.textBaseline='bottom';
                        ctx.fillText(label, right-5, yPos-3);
                    }
                } else {
                    const xPos = scales.x.getPixelForValue(options.value);
                    if (xPos >= left - 2 && xPos <= right + 2) {
                        ctx.moveTo(xPos, top); ctx.lineTo(xPos, bottom); ctx.stroke();
                        ctx.fillStyle='rgba(255,255,255,0.85)'; ctx.font='bold 11px Inter'; ctx.textAlign='left'; ctx.textBaseline='top';
                        ctx.fillText(label, xPos+5, top+5);
                    }
                }
                ctx.restore();
            }
        };

        function getChartMinVal(rates, def=96) {
            const v=rates.filter(r=>r>0); if(!v.length) return def;
            return Math.floor(Math.min(...v,def));
        }

        function getTop5DefectsTooltipInfo(lineName) {
            const shortName = lineName.startsWith('Line ') ? lineName.replace('Line ', '').split(' ')[0] : lineName.split(' ')[0];
            const relatedDefects = (defectData.byLine || []).filter(l => l.lineName.includes(`Line ${shortName} (`));
            
            if (relatedDefects.length === 0) return ['\nTop 5 Defects:', '  No defects recorded'];
            
            let allDefects = [];
            relatedDefects.forEach(ld => {
                const sideMatch = ld.lineName.match(/\((.*?)\)/);
                const sideLabel = sideMatch ? `[${sideMatch[1]}]` : '';
                (ld.defects || []).forEach(d => {
                    allDefects.push({ name: `${d.name} ${sideLabel}`, count: d.count });
                });
            });
            
            if (allDefects.length === 0) return ['\nTop 5 Defects:', '  No defects recorded'];
            
            let map = {};
            allDefects.forEach(d => {
                if (!map[d.name]) map[d.name] = 0;
                map[d.name] += d.count;
            });
            
            const aggregated = Object.keys(map).map(k => ({ name: k, count: map[k] }));
            const top5 = aggregated.sort((a, b) => b.count - a.count).slice(0, 5);
            return ['\nTop 5 Defects:', ...top5.map(d => `  • ${d.name}: ${d.count}`)];
        }

        function getTop5PickupLossTooltipInfo(lineName) {
            const foundLine = pickupLossData.find(l => l.lineName === lineName);
            if (!foundLine || !foundLine.defects || foundLine.defects.length === 0) return ['\nTop 5 Feeders:', '  No data recorded'];
            return ['\nTop 5 Feeders:', ...foundLine.defects.map(d => `  • ${d.name}: ${d.count} misses`)];
        }

        function getProcessPassRateByLine(processName) {
            let map = {};
            linesData.forEach(l => {
                let nameStr = l.name || l.lineName || (l.line ? `Line ${l.line}` : 'Line_1');
                let name = nameStr.replace('Line ', '').split(' ')[0]; // Gets Line_Lane
                if(!map[name]) map[name] = { in: 0, out: 0 };
                const pData = l.processes?.[processName];
                if (pData) {
                    map[name].in += pData.input || 0;
                    map[name].out += pData.output || 0;
                }
            });
            return Object.keys(map).sort().map(k => {
                const totalIn = map[k].in;
                const totalOut = map[k].out;
                const passRate = totalIn > 0 ? (totalOut / totalIn * 100) : 100;
                return { line: k, passRate: passRate, totalIn: totalIn, totalOut: totalOut };
            });
        }

