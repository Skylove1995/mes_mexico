            let labels = [];
            let actualOutputs = [];
            let targets = [];

            if (linesData && linesData.length > 0) {
                linesData.forEach((l, idx) => {
                    let nameStr = l.line_lane || l.name || (l.line ? `Line ${l.line}${l.lane ? ' - ' + l.lane : ''}` : `Line ${idx + 1}`);
                    let cleanLine = l.name ? l.name.replace(' (Top)', '').replace(' (Bottom)', '').trim() : (l.line ? `Line ${l.line}` : '');
                    let outVal = l.output != null ? l.output : (l.actualOutput != null ? l.actualOutput : 0);
                    let targetVal = l.target || l.targetQty || l.uphTarget || serverLineTargets[cleanLine] || serverLineTargets[l.name] || getUphTargetFromDict(l.line || l.name, l.lane, l.smtPn) || 5000;

                    labels.push(nameStr);
