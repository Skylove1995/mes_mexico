        async function setLineTargetServer(line, target) {
            try {
                serverLineTargets[line] = target; // optimistic update
                await fetch('/api/SmtApi/dashboard/set-target', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ line: line, target: target })
                });
