        async function saveUphDictInline(id) {
            const line = document.getElementById(`uph-line-${id}`)?.value.trim() || '';
            const lane = document.getElementById(`uph-lane-${id}`)?.value.trim() || '1';
            const smtPn = document.getElementById(`uph-smtpn-${id}`)?.value.trim() || 'ALL';
            const uphRaw = document.getElementById(`uph-val-${id}`)?.value;
            const uphVal = uphRaw !== '' && !isNaN(parseInt(uphRaw, 10)) ? parseInt(uphRaw, 10) : null;

            if (!line) {
                alert("Vui lòng nhập Tên Dây Chuyền (Line)");
                return;
            }

            // Check existence when adding a new record
            if (id === 0 && allUphDictTargets && allUphDictTargets.length > 0) {
                const exists = allUphDictTargets.some(x =>
                    (x.line || '').toString().trim() === line.toString().trim() &&
                    (x.lane || '1').toString().trim() === lane.toString().trim() &&
                    (x.smtPn || 'ALL').toLowerCase().trim() === smtPn.toLowerCase().trim()
                );
                if (exists) {
                    alert(`UPH Target cho Line ${line}, Lane ${lane}, Mã SP ${smtPn} đã tồn tại! Vui lòng tìm và chỉnh sửa trực tiếp dòng hiện có trong bảng.`);
                    return;
                }
            }

            try {
                const res = await fetch('/api/SmtApi/dashboard/save-uph-dict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, line, lane, smtPn, uph: uphVal })
                });

                const result = await res.json();
                if (res.ok && result.success) {
                    await loadUphDictTable();
                    await fetchMasterTargets();
                    await loadDashboardData(true);
                } else {
                    alert("Lưu UPH Target thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Lưu lỗi: " + e.message);
            }
        }

