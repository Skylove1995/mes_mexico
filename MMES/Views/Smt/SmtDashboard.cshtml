                pickupTargetEl.innerHTML = renderTargetBadge("PICKUP LOSS", "Limit < ", "%");
            }
            const yieldTargetEl = document.getElementById('g_yield_target');
            if(yieldTargetEl) {
                yieldTargetEl.innerHTML = renderTargetBadge("YIELD RATE", "Target ", "%");
            }

            // OEE Calculation using DB Planned Working Hours (tb_dashboard_smt_working_time)
            const totalPlannedHours = (globalSummaryData && globalSummaryData.totalPlannedHours > 0)
                ? globalSummaryData.totalPlannedHours
                : Math.max(1, linesData.length * 12);
            
            const availability = (globalSummaryData && globalSummaryData.availability != null)
                ? globalSummaryData.availability / 100
                : Math.max(0, 1 - (idle / totalPlannedHours));

            // Calculate realtime elapsed hours ratio to pro-rate target sum
            const now = new Date();
            let shiftStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 8, 0, 0);
            if (now < shiftStart) {
                shiftStart.setDate(shiftStart.setDate() - 1);
            }
            const elapsedHours = Math.max(0.1, Math.min(24.0, (now - shiftStart) / 3600000));
            const shiftHoursPerLane = 19.75;
            const realtimeRatio = Math.min(1.0, elapsedHours / shiftHoursPerLane);

            const activeTargetVal = (globalSummaryData && globalSummaryData.totalTargetInputPlan > 0)
                ? globalSummaryData.totalTargetInputPlan
                : targetSum;
            const realtimeTarget = activeTargetVal * realtimeRatio;

            const performance = realtimeTarget > 0 ? Math.min(1, out / realtimeTarget) : 0;
            const quality = pr / 100;
            const oeeVal = (globalSummaryData && globalSummaryData.oee != null)
                ? globalSummaryData.oee
                : (availability * performance * quality * 100);

            const oeeEl = document.getElementById('g_oee');
