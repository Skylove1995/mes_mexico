        }

        function formatNumber(n) {
            if (n === null || n === undefined) return '';
            if (typeof n === 'number') {
                const cleaned = Math.round((n + Number.EPSILON) * 10000) / 10000;
                return cleaned.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            }
            return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

