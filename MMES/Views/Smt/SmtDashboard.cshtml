            document.getElementById('targetSetupModal').style.display = 'flex';
            renderPresetChips();
            await loadDashboardViewMode();
            await loadTargetTable();
            await loadUphDictTable();
        }

        function closeTargetModal() {
            document.getElementById('targetSetupModal').style.display = 'none';
        }

        function renderPresetChips(activeName = '') {
            const container = document.getElementById('presetChipsGrid');
            if (!container) return;
            container.innerHTML = presetMetricsList.map(m => {
                const isActive = activeName && activeName.toUpperCase() === m.name.toUpperCase();
                const icon = m.external ? 'bi bi-link-45deg' : 'bi bi-tag-fill';
                const extraTag = m.external ? ' <span style="font-size:0.65rem; color:#eab308;">(Dict)</span>' : '';
                return `<div class="preset-chip ${isActive ? 'active' : ''}" onclick="selectPresetTarget('${m.name}')">
                    <i class="${icon}" style="font-size:0.75rem; color: var(--c-cyan);"></i> ${m.name}${extraTag}
                </div>`;
            }).join('');
        }

        function parseCompareTarget(compStr) {
            if (!compStr) return { operator: '>=', period: 'Daily' };
            const parts = compStr.split('|').map(s => s.trim());
            const operator = parts[0] || '>=';
            const period = parts[1] || 'Daily';
            return { operator, period };
        }

        function getPeriodLabel(periodKey) {
            switch ((periodKey || '').toLowerCase()) {
                case 'shift': return { text: '⏱️ Theo ca', cls: 'shift' };
                case 'daily': return { text: '📅 Theo ngày', cls: 'daily' };
                case 'weekly': return { text: '📆 Theo tuần', cls: 'weekly' };
                case 'monthly': return { text: '🗓️ Theo tháng', cls: 'monthly' };
                case 'yearly': return { text: '📊 Theo năm', cls: 'yearly' };
                case 'realtime': return { text: '⚡ Thời gian thực', cls: 'realtime' };
                default: return { text: periodKey || 'Theo ngày', cls: 'daily' };
            }
        }

        function selectPresetTarget(targetName) {
            renderPresetChips(targetName);
            const existing = allSmtTargets.find(x => x.targetName && x.targetName.trim().toUpperCase() === targetName.toUpperCase());
            const presetDef = presetMetricsList.find(x => x.name === targetName);

            const uphNotice = document.getElementById('uphNoticeBanner');
            if (uphNotice) {
                uphNotice.style.display = (targetName.toUpperCase() === 'UPH') ? 'block' : 'none';
            }

            if (existing) {
                document.getElementById('targetId').value = existing.id;
                document.getElementById('targetName').value = existing.targetName;
                document.getElementById('targetValue').value = existing.targetValue ?? '';
                document.getElementById('targetUnit').value = existing.targetUnit || (presetDef ? presetDef.unit : 'pcs');
                
                const parsed = parseCompareTarget(existing.compareTarget);
                document.getElementById('compareOperator').value = parsed.operator;
                document.getElementById('targetPeriod').value = parsed.period;
            } else {
                document.getElementById('targetId').value = 0;
                document.getElementById('targetName').value = targetName;
                document.getElementById('targetValue').value = '';
                document.getElementById('targetUnit').value = presetDef ? presetDef.unit : 'pcs';
                document.getElementById('compareOperator').value = presetDef ? presetDef.compare : '>=';
                document.getElementById('targetPeriod').value = presetDef ? presetDef.period : (presetName => {
                    if (['SPI PASS RATE', 'MOI PASS RATE', 'AOI PASS RATE', 'PICKUP LOSS', 'YIELD RATE', 'DEFECT TREND'].includes(presetName)) return 'Monthly';
                    return 'Daily';
                })(targetName);
            }

            renderPeriodEntryTable();
        }

        function renderPeriodEntryTable() {
            const container = document.getElementById('periodEntryContainer');
            if (!container) return;

            const targetName = (document.getElementById('targetName').value || '').trim();
            const period = document.getElementById('targetPeriod').value || 'Daily';
            const presetDef = presetMetricsList.find(x => x.name.toUpperCase() === targetName.toUpperCase());
            const defaultValue = presetDef ? presetDef.target : '';
            const unit = document.getElementById('targetUnit').value || '';
            const currentYear = new Date().getFullYear();
            const currentMonth = new Date().getMonth() + 1;

            if (!targetName) {
                container.innerHTML = '';
                return;
            }

            if (period === 'Monthly') {
                let html = `
                <div class="period-entry-card">
                    <div class="period-entry-header">
                        <div class="period-entry-title">
                            <i class="bi bi-calendar3-range me-1" style="color: #38bdf8;"></i> Bảng Cấu Hình Target 12 Tháng (${currentYear}) — <span style="color: #fde047;">${escapeHtml(targetName)}</span>
                        </div>
                        <div class="quick-fill-wrap">
                            <input type="number" step="0.01" id="quickFillVal" class="quick-fill-input" placeholder="Nhập..." value="${defaultValue}" />
                            <button type="button" class="btn-quick-apply" onclick="applyQuickFill()"><i class="bi bi-lightning-charge-fill me-1"></i> Áp dụng tất cả (12 Tháng)</button>
                        </div>
                    </div>
                    <div class="period-grid-monthly">`;

                for (let m = 1; m <= 12; m++) {
                    const monthPadded = m < 10 ? '0' + m : '' + m;
                    const subKey = `${currentYear}_M${monthPadded}`;
                    const subName = `${targetName}_${subKey}`;
                    const existingSub = allSmtTargets.find(x => x.targetName && x.targetName.trim().toUpperCase() === subName.toUpperCase());
                    const val = existingSub && existingSub.targetValue != null ? existingSub.targetValue : defaultValue;

                    html += `
                        <div class="period-item-box">
                            <div class="period-item-label">Thg ${m}</div>
                            <input type="number" step="0.01" class="period-item-input" data-key="${subKey}" value="${val !== '' ? val : ''}" placeholder="${unit ? unit : 'Nhập'}" />
                        </div>`;
                }

                html += `</div></div>`;
                container.innerHTML = html;
            }
            else if (period === 'Daily') {
                const daysInMonth = new Date(currentYear, currentMonth, 0).getDate();
                const monthPadded = currentMonth < 10 ? '0' + currentMonth : '' + currentMonth;

                let html = `
                <div class="period-entry-card">
                    <div class="period-entry-header">
                        <div class="period-entry-title">
                            <i class="bi bi-calendar-date me-1" style="color: #38bdf8;"></i> Bảng Target Các Ngày Trong Tháng ${currentMonth}/${currentYear} — <span style="color: #fde047;">${escapeHtml(targetName)}</span>
                        </div>
                        <div class="quick-fill-wrap">
                            <input type="number" step="0.01" id="quickFillVal" class="quick-fill-input" placeholder="Nhập..." value="${defaultValue}" />
                            <button type="button" class="btn-quick-apply" onclick="applyQuickFill()"><i class="bi bi-lightning-charge-fill me-1"></i> Áp dụng tất cả (${daysInMonth} Ngày)</button>
                        </div>
                    </div>
                    <div class="period-grid-daily">`;

                for (let d = 1; d <= daysInMonth; d++) {
                    const dayPadded = d < 10 ? '0' + d : '' + d;
                    const subKey = `${currentYear}${monthPadded}_D${dayPadded}`;
                    const subName = `${targetName}_${subKey}`;
                    const existingSub = allSmtTargets.find(x => x.targetName && x.targetName.trim().toUpperCase() === subName.toUpperCase());
                    const val = existingSub && existingSub.targetValue != null ? existingSub.targetValue : defaultValue;

                    html += `
                        <div class="period-item-box">
                            <div class="period-item-label">N. ${d}</div>
                            <input type="number" step="0.01" class="period-item-input" data-key="${subKey}" value="${val !== '' ? val : ''}" placeholder="Nhập..." />
                        </div>`;
                }

                html += `</div></div>`;
                container.innerHTML = html;
            }
            else if (period === 'Weekly') {
                const monthPadded = currentMonth < 10 ? '0' + currentMonth : '' + currentMonth;
                let html = `
                <div class="period-entry-card">
                    <div class="period-entry-header">
                        <div class="period-entry-title">
                            <i class="bi bi-calendar-week me-1" style="color: #38bdf8;"></i> Bảng Target Các Tuần Trong Tháng ${currentMonth}/${currentYear} — <span style="color: #fde047;">${escapeHtml(targetName)}</span>
                        </div>
                        <div class="quick-fill-wrap">
                            <input type="number" step="0.01" id="quickFillVal" class="quick-fill-input" placeholder="Nhập..." value="${defaultValue}" />
                            <button type="button" class="btn-quick-apply" onclick="applyQuickFill()"><i class="bi bi-lightning-charge-fill me-1"></i> Áp dụng tất cả (5 Tuần)</button>
                        </div>
                    </div>
                    <div class="period-grid-weekly" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;">`;

                for (let w = 1; w <= 5; w++) {
                    const subKey = `${currentYear}${monthPadded}_W0${w}`;
                    const subName = `${targetName}_${subKey}`;
                    const existingSub = allSmtTargets.find(x => x.targetName && x.targetName.trim().toUpperCase() === subName.toUpperCase());
                    const val = existingSub && existingSub.targetValue != null ? existingSub.targetValue : defaultValue;

                    html += `
                        <div class="period-item-box">
                            <div class="period-item-label">Tuần ${w}</div>
                            <input type="number" step="0.01" class="period-item-input" data-key="${subKey}" value="${val !== '' ? val : ''}" placeholder="Nhập..." />
                        </div>`;
                }

                html += `</div></div>`;
                container.innerHTML = html;
            }
            else {
                container.innerHTML = '';
            }
        }

        function applyQuickFill() {
            const qVal = document.getElementById('quickFillVal').value;
            if (qVal === '') return;
            document.querySelectorAll('.period-item-input').forEach(inp => {
                inp.value = qVal;
            });
        }

        async function loadTargetTable() {
            const tbody = document.getElementById('targetTableBody');
            try {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px;">Đang tải dữ liệu...</td></tr>';
                const res = await fetch('/api/SmtApi/dashboard/targets');
                if (!res.ok) throw new Error("HTTP error " + res.status);
                const data = await res.json();
                allSmtTargets = data.data || [];
                
                if (allSmtTargets.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px; color: #94a3b8;">Chưa có target nào trong CSDL. Thêm target mới ở trên.</td></tr>';
                    return;
                }

                // Filter out period sub-target entries (_M01, _D01, _S1) from primary main list display
                const mainList = allSmtTargets.filter(t => !t.targetName || (!t.targetName.match(/_(\d{4}_M\d{2}|\d{6}_D\d{2}|S\d)$/) && t.targetName.trim().toUpperCase() !== 'TOTAL OUTPUT'));

                tbody.innerHTML = mainList.map(t => {
                    const parsed = parseCompareTarget(t.compareTarget);
                    const periodInfo = getPeriodLabel(parsed.period);
                    return `
                        <tr>
                            <td>${t.id}</td>
                            <td style="font-weight: 700; color: #38bdf8;">${escapeHtml(t.targetName || '')}</td>
                            <td style="font-weight: 700; color: #eab308;">${t.targetValue != null ? formatNumber(t.targetValue) : '—'}</td>
                            <td><span style="background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">${escapeHtml(t.targetUnit || 'pcs')}</span></td>
                            <td><span class="period-badge ${periodInfo.cls}">${periodInfo.text}</span></td>
                            <td><code style="color: #eab308; background: rgba(234,179,8,0.1); padding: 2px 6px; border-radius: 4px;">${escapeHtml(parsed.operator)}</code></td>
                            <td style="font-size: 0.75rem; color: #94a3b8;">${t.targetTime ? new Date(t.targetTime).toLocaleString('vi-VN') : '—'}</td>
                            <td style="text-align: right;">
                                <button class="btn-target-edit" onclick="editTargetItem(${t.id})"><i class="bi bi-pencil"></i> Sửa</button>
                                <button class="btn-target-del" onclick="deleteTargetItem(${t.id})"><i class="bi bi-trash"></i> Xóa</button>
                            </td>
                        </tr>
                    `;
                }).join('');

                renderPeriodEntryTable();
            } catch(e) {
                console.error(e);
                tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #ef4444; padding: 20px;">Không thể tải dữ liệu: ${e.message}</td></tr>`;
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function editTargetItem(id) {
            const item = allSmtTargets.find(x => x.id === id);
            if (!item) return;
            document.getElementById('targetId').value = item.id;
            document.getElementById('targetName').value = item.targetName || '';
            document.getElementById('targetValue').value = item.targetValue != null ? formatNumber(item.targetValue) : '';
            document.getElementById('targetUnit').value = item.targetUnit || 'pcs';
            
            const parsed = parseCompareTarget(item.compareTarget);
            document.getElementById('compareOperator').value = parsed.operator;
            document.getElementById('targetPeriod').value = parsed.period;

            renderPresetChips(item.targetName || '');
            renderPeriodEntryTable();
        }

        function resetTargetForm() {
            document.getElementById('targetId').value = 0;
            document.getElementById('targetName').value = '';
            document.getElementById('targetValue').value = '';
            document.getElementById('targetUnit').value = 'pcs';
            document.getElementById('compareOperator').value = '>=';
            document.getElementById('targetPeriod').value = 'Daily';
            renderPresetChips('');
            renderPeriodEntryTable();
        }

        async function saveTargetItem() {
            const id = parseInt(document.getElementById('targetId').value, 10) || 0;
            const targetName = document.getElementById('targetName').value.trim();
            const targetValue = parseFloat(document.getElementById('targetValue').value);
            const targetUnit = document.getElementById('targetUnit').value.trim();
            const compareOperator = document.getElementById('compareOperator').value;
            const targetPeriod = document.getElementById('targetPeriod').value;
            const compareTarget = `${compareOperator} | ${targetPeriod}`;

            if (!targetName) {
                alert("Vui lòng nhập hoặc chọn Tên Target");
                return;
            }

            const periodValues = {};
            document.querySelectorAll('.period-item-input').forEach(inp => {
                const key = inp.dataset.key;
                const v = parseFloat(inp.value);
                if (key && !isNaN(v)) {
                    periodValues[key] = v;
                }
            });

            let mainVal = targetValue;
            if (isNaN(mainVal)) {
                const firstVal = Object.values(periodValues)[0];
                if (firstVal != null) mainVal = firstVal;
                else mainVal = 0;
            }

            try {
                const res = await fetch('/api/SmtApi/dashboard/save-target', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, targetName, targetValue: mainVal, targetUnit, compareTarget, periodValues })
                });

                const result = await res.json();
                if (res.ok && result.success) {
                    resetTargetForm();
                    await loadTargetTable();
                    await loadDashboardData(true);
                } else {
                    alert("Lưu thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Lưu lỗi: " + e.message);
            }
        }

        async function deleteTargetItem(id) {
            if (!confirm("Bạn có chắc chắn muốn xóa target này?")) return;
            try {
                const res = await fetch(`/api/SmtApi/dashboard/delete-target/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (res.ok && result.success) {
                    await loadTargetTable();
                    await loadDashboardData(true);
                } else {
                    alert("Xóa thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Xóa lỗi: " + e.message);
            }
        }

        // =================================================================
        // UPH DICTIONARY & WORKING TIME TARGET MANAGEMENT JS
        // =================================================================
        function switchTargetModalTab(tabName, btn) {
            document.querySelectorAll('.modal-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            
            const generalTab = document.getElementById('targetTabGeneral');
            const uphDictTab = document.getElementById('targetTabUphDict');
            const wtTab = document.getElementById('targetTabWorkingTime');
            const ltTab = document.getElementById('targetTabLossTime');

            if (tabName === 'uphDict') {
                if (generalTab) generalTab.style.display = 'none';
                if (uphDictTab) uphDictTab.style.display = 'block';
                if (wtTab) wtTab.style.display = 'none';
                if (ltTab) ltTab.style.display = 'none';
                loadUphDictTable();
            } else if (tabName === 'workingTime') {
                if (generalTab) generalTab.style.display = 'none';
                if (uphDictTab) uphDictTab.style.display = 'none';
                if (wtTab) wtTab.style.display = 'block';
                if (ltTab) ltTab.style.display = 'none';
                loadWorkingTimeTable();
            } else if (tabName === 'lossTime') {
                if (generalTab) generalTab.style.display = 'none';
                if (uphDictTab) uphDictTab.style.display = 'none';
                if (wtTab) wtTab.style.display = 'none';
                if (ltTab) ltTab.style.display = 'block';
                loadLossTimeTable();
            } else {
                if (generalTab) generalTab.style.display = 'block';
                if (uphDictTab) uphDictTab.style.display = 'none';
                if (wtTab) wtTab.style.display = 'none';
                if (ltTab) ltTab.style.display = 'none';
            }
        }

        // --- WORKING TIME & MAN POWER FUNCTIONS ---
        let currentWorkingTimeRows = [];

        function getDefaultManPower(lineNum) {
            const l = parseInt(lineNum, 10);
            if (l === 1 || l === 2) return 5;
            if (l === 6) return 2;
            return 3;
        }

        function formatNumberInputWithCommas(input) {
            const val = input.value.replace(/[^0-9]/g, '');
            if (!val) {
                input.value = '';
                return;
            }
            input.value = parseInt(val, 10).toLocaleString('en-US');
        }

        async function loadWorkingTimeTable() {
            const tbody = document.getElementById('wtTableBody');
            if (!tbody) return;

            const dateElem = document.getElementById('wtFilterDate');
            if (dateElem && !dateElem.value) {
                dateElem.value = new Date().toISOString().split('T')[0];
            }
            const selectedDate = dateElem ? dateElem.value : new Date().toISOString().split('T')[0];

            const lineCountElem = document.getElementById('wtLineCount');
            const numLines = lineCountElem ? parseInt(lineCountElem.value, 10) : 6;

            try {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 20px;">Đang tải dữ liệu Working Time...</td></tr>';
                
                const res = await fetch(`/api/SmtApi/dashboard/working-time?prodDate=${selectedDate}`);
                if (!res.ok) throw new Error("HTTP error " + res.status);
                const data = await res.json();
                const existingRecords = data.data || [];

                currentWorkingTimeRows = [];
                let rowsHtml = '';

                for (let line = 1; line <= numLines; line++) {
                    for (let lane = 1; lane <= 2; lane++) {
                        const lineStr = line.toString();
                        const laneStr = lane.toString();

                        const existing = existingRecords.find(x => {
                            const dbLine = (x.lineCode || x.line || '').toString().trim().replace(/^line\s*/i, '');
                            const dbLane = (x.laneCode || x.lane || '').toString().trim().replace(/^l/i, '');
                            return dbLine === lineStr && dbLane === laneStr;
                        });

                        const id = existing ? existing.id : 0;
                        const rawTargetInput = existing && existing.targetInputPlan != null ? existing.targetInputPlan : '';
                        const formattedInputPlan = rawTargetInput !== '' && rawTargetInput != null && !isNaN(parseInt(rawTargetInput, 10)) 
                            ? parseInt(rawTargetInput, 10).toLocaleString('en-US') 
                            : '';
                        const targetWorkingHours = existing && existing.targetWorkingHours != null ? existing.targetWorkingHours : (existing && existing.planWorkingHour != null ? existing.planWorkingHour : 19.75);
                        const manPower = existing && existing.manPower != null ? existing.manPower : getDefaultManPower(line);

                        const rowKey = `${line}_${lane}`;
                        currentWorkingTimeRows.push({ rowKey, id, prodDate: selectedDate, lineCode: lineStr, laneCode: laneStr });

                        const lineBorder = (lane === 1 && line > 1) ? 'border-top: 2px solid rgba(168, 85, 247, 0.4);' : '';
                        const lineBg = (line % 2 === 0) ? 'background: rgba(168, 85, 247, 0.02);' : '';
                        const rowStyle = `${lineBorder} ${lineBg}`.trim();

                        rowsHtml += `
                            <tr id="wt-row-${rowKey}" style="${rowStyle}">
                                <td>
                                    <span style="color: #c084fc; font-weight: 600; font-size: 0.8rem;">${selectedDate}</span>
                                </td>
                                <td>
                                    <span style="color: #38bdf8; font-weight: 700; font-size: 0.85rem;">Line ${lineStr}</span>
                                </td>
                                <td>
                                    <span class="period-badge daily" style="font-weight: 700; font-size: 0.8rem;">Lane ${laneStr}</span>
                                </td>
                                <td>
                                    <input type="text" id="wt-input-plan-${rowKey}" value="${formattedInputPlan}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; font-weight: 700; color: #38bdf8; width: 110px;" placeholder="Input Plan..." oninput="formatNumberInputWithCommas(this)" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0" max="24" id="wt-hours-${rowKey}" value="${targetWorkingHours}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; font-weight: 700; color: #10b981; width: 100px;" placeholder="Hours..." />
                                </td>
                                <td>
                                    <input type="number" step="1" min="0" id="wt-mp-${rowKey}" value="${manPower}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; font-weight: 700; color: #f59e0b; width: 90px;" placeholder="ManPower..." />
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button class="btn-target-save" style="padding: 4px 10px; font-size: 0.75rem; background: linear-gradient(135deg, #a855f7, #7c3aed);" onclick="saveWorkingTimeRow('${rowKey}')">
                                        <i class="bi bi-check-lg me-1"></i> Lưu
                                    </button>
                                </td>
                            </tr>
                        `;
                    }
                }

                tbody.innerHTML = rowsHtml;
            } catch(e) {
                console.error(e);
                tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 20px;">Không thể tải Working Time: ${e.message}</td></tr>`;
            }
        }

        async function saveWorkingTimeRow(rowKey) {
            const rowInfo = currentWorkingTimeRows.find(r => r.rowKey === rowKey);
            if (!rowInfo) return;

            const inputPlanRaw = (document.getElementById(`wt-input-plan-${rowKey}`)?.value || '').replace(/,/g, '').trim();
            const hoursRaw = document.getElementById(`wt-hours-${rowKey}`)?.value;
            const mpRaw = document.getElementById(`wt-mp-${rowKey}`)?.value;

            const payload = {
                id: rowInfo.id,
                prodDate: rowInfo.prodDate,
                line: rowInfo.lineCode,
                lineCode: rowInfo.lineCode,
                lane: rowInfo.laneCode,
                laneCode: rowInfo.laneCode,
                targetInputPlan: inputPlanRaw !== '' && !isNaN(parseInt(inputPlanRaw, 10)) ? parseInt(inputPlanRaw, 10) : null,
                planWorkingHour: hoursRaw !== '' && !isNaN(parseFloat(hoursRaw)) ? parseFloat(hoursRaw) : null,
                targetWorkingHours: hoursRaw !== '' && !isNaN(parseFloat(hoursRaw)) ? parseFloat(hoursRaw) : null,
                manPower: mpRaw !== '' && !isNaN(parseInt(mpRaw, 10)) ? parseInt(mpRaw, 10) : null
            };

            try {
                const res = await fetch('/api/SmtApi/dashboard/save-working-time', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (res.ok && result.success) {
                    if (result.data && result.data.id) {
                        rowInfo.id = result.data.id;
                    }
                    alert(`Lưu thành công Line ${rowInfo.lineCode} - Lane ${rowInfo.laneCode}!`);
                } else {
                    alert("Lưu Working Time thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Lỗi kết nối: " + e.message);
            }
        }

        async function saveAllWorkingTime() {
            if (!currentWorkingTimeRows || currentWorkingTimeRows.length === 0) {
                alert("Không có dữ liệu để lưu!");
                return;
            }

            const payloadList = currentWorkingTimeRows.map(rowInfo => {
                const inputPlanRaw = (document.getElementById(`wt-input-plan-${rowInfo.rowKey}`)?.value || '').replace(/,/g, '').trim();
                const hoursRaw = document.getElementById(`wt-hours-${rowInfo.rowKey}`)?.value;
                const mpRaw = document.getElementById(`wt-mp-${rowInfo.rowKey}`)?.value;

                return {
                    id: rowInfo.id,
                    prodDate: rowInfo.prodDate,
                    line: rowInfo.lineCode,
                    lineCode: rowInfo.lineCode,
                    lane: rowInfo.laneCode,
                    laneCode: rowInfo.laneCode,
                    targetInputPlan: inputPlanRaw !== '' && !isNaN(parseInt(inputPlanRaw, 10)) ? parseInt(inputPlanRaw, 10) : null,
                    planWorkingHour: hoursRaw !== '' && !isNaN(parseFloat(hoursRaw)) ? parseFloat(hoursRaw) : null,
                    targetWorkingHours: hoursRaw !== '' && !isNaN(parseFloat(hoursRaw)) ? parseFloat(hoursRaw) : null,
                    manPower: mpRaw !== '' && !isNaN(parseInt(mpRaw, 10)) ? parseInt(mpRaw, 10) : null
                };
            });

            try {
                const res = await fetch('/api/SmtApi/dashboard/save-working-time-batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payloadList)
                });
                const result = await res.json();
                if (res.ok && result.success) {
                    alert(result.message || "Lưu tất cả Working Time thành công!");
                    await loadWorkingTimeTable();
                } else {
                    alert("Lưu hàng loạt thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Lỗi khi kết nối API: " + e.message);
            }
        }

        async function loadUphDictTable() {
            const tbody = document.getElementById('uphDictTableBody');
            if (!tbody) return;
            try {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px;">Đang tải dữ liệu...</td></tr>';
                const res = await fetch('/api/SmtApi/dashboard/uph-dict');
                if (!res.ok) throw new Error("HTTP error " + res.status);
                const data = await res.json();
                allUphDictTargets = data.data || [];

                filterUphDictTable();
            } catch(e) {
                console.error(e);
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #ef4444; padding: 20px;">Không thể tải UPH Dict: ${e.message}</td></tr>`;
            }
        }

        function filterUphDictTable() {
            const tbody = document.getElementById('uphDictTableBody');
            if (!tbody) return;

            const filterText = (document.getElementById('uphDictFilterPn')?.value || '').trim().toLowerCase();

            const filtered = (allUphDictTargets || []).filter(u => {
                if (!filterText) return true;
                const pn = (u.smtPn || '').toLowerCase();
                const line = (u.line || '').toLowerCase();
                const lane = (u.lane || '').toLowerCase();
                return pn.includes(filterText) || line.includes(filterText) || lane.includes(filterText);
            });

            const rowsHtml = filtered.map(u => `
                <tr id="uph-row-${u.id}">
                    <td style="color: #64748b; font-size: 0.75rem; font-weight: 600;">${u.id}</td>
                    <td>
                        <input type="number" min="1" id="uph-line-${u.id}" value="${escapeHtml(u.line || '')}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; font-weight: 700; color: #38bdf8; width: 80px;" placeholder="Line..." />
                    </td>
                    <td>
                        <input type="number" min="1" id="uph-lane-${u.id}" value="${escapeHtml(u.lane || '1')}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; width: 70px;" placeholder="Lane..." />
                    </td>
                    <td>
                        <input type="text" id="uph-smtpn-${u.id}" value="${escapeHtml(u.smtPn || 'ALL')}" class="target-input" style="padding: 3px 6px; font-size: 0.8rem; color: #eab308; font-weight: 600; width: 140px;" placeholder="Smt P/N..." />
                    </td>
