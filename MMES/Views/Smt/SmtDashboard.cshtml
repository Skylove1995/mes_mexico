@{
    Layout = null;
    ViewData["Title"] = "SMT Production Dashboard";

    string uname = null, auth = null, role = null, position = null;
    try {
        uname = Context.Session?.GetString("uname");
        auth = Context.Session?.GetString("auth");
        role = Context.Session?.GetString("role");
        position = Context.Session?.GetString("position");
    } catch {}

    bool isLoggedIn = !string.IsNullOrWhiteSpace(uname) || !string.IsNullOrWhiteSpace(auth);
    bool isAdmin = isLoggedIn && (
        string.Equals(auth, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(role, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(position, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(uname, "admin", StringComparison.OrdinalIgnoreCase)
    );
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SMT Production Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <style>
        :root {
            --c-cyan:    #38bdf8;
            --c-blue:    #3b82f6;
            --c-orange:  #f59e0b;
            --c-red:     #ef4444;
            --c-green:   #10b981;
            --c-purple:  #8b5cf6;
            --bg:        #020617;
            --panel:     linear-gradient(135deg, rgba(47, 87, 138, 0.22) 0%, rgba(15, 32, 57, 0.12) 100%);
            --border:    rgba(255,255,255,0.08);
            --muted:     #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: 
                /* Glass reflection diagonal sheen */
                linear-gradient(115deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.04) 15%, rgba(255, 255, 255, 0.12) 18%, rgba(255, 255, 255, 0.02) 20%, rgba(255, 255, 255, 0) 40%),
                /* Top light reflection */
                linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 100%),
                /* Ambient glow from top using a lighter desaturated #2F578A */
                radial-gradient(circle at 50% 10%, rgba(86, 131, 190, 0.3) 0%, transparent 60%),
                /* Base background transitioning from desaturated 2F578A to very deep steel blue */
                radial-gradient(ellipse at top, #1f3d64 0%, #08111c 100%);
            font-family: 'Inter', sans-serif;
            color: #ffffff;
            height: 100vh;
            overflow: hidden;
            padding: 15px 30px;
            display: flex; flex-direction: column; gap: 15px;
            position: relative;
        }

        body::after {
            content: '';
            position: absolute;
            inset: 8px;
            border: 1px solid transparent;
            background: linear-gradient(135deg, 
                rgba(255,255,255,0.12) 0%, 
                rgba(56, 189, 248, 0.5) 20%, 
                rgba(255,255,255,0.04) 40%, 
                rgba(139, 92, 246, 0.4) 70%, 
                rgba(255,255,255,0.15) 100%
            ) border-box;
            -webkit-mask:
                linear-gradient(#fff 0 0) padding-box, 
                linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 9999;
            border-radius: 12px;
            box-shadow: inset 0 0 15px rgba(56, 189, 248, 0.06);
        }

        /* HEADER */
        .hud-header {
            display: flex; align-items: center; justify-content: flex-start; gap: 20px;
            height: 50px; flex-shrink: 0;
            border-bottom: 1px solid rgba(56, 189, 248, 0.3);
            padding-bottom: 10px;
        }
        .header-left { display: flex; align-items: center; gap: 12px; margin-right: auto; }
        .banner-title { font-size: 1.6rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: #eab308; }
        .banner-sub { font-size: 1.2rem; font-weight: 600; color: var(--c-cyan); border-left: 2px solid rgba(255,255,255,0.2); padding-left: 20px; text-transform: uppercase; }
        .clock-block { font-family: 'Share Tech Mono', monospace; font-size: 1.2rem; color: #fff; margin-left: auto; display: flex; align-items: center; gap: 8px; }
        .env-block {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.05rem;
            font-weight: 700;
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 8px;
            padding: 4px 12px;
            margin-left: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(8px);
            position: relative;
            cursor: pointer;
            z-index: 101;
            transition: all 0.3s ease;
        }
        .env-block:hover {
            z-index: 99999;
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
        }
        .env-temp { color: #f43f5e; display: flex; align-items: center; gap: 4px; }
        .env-hum { color: #38bdf8; display: flex; align-items: center; gap: 4px; }
        .env-sep { color: rgba(255, 255, 255, 0.25); font-size: 0.85rem; }
        .env-hover-panel {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 360px;
            max-height: 420px;
            overflow-y: auto;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.98) 0%, rgba(10, 15, 30, 0.99) 100%);
            border: 1px solid rgba(56, 189, 248, 0.45);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.85), 0 0 30px rgba(56, 189, 248, 0.25);
            border-radius: 12px;
            padding: 14px 16px;
            z-index: 99999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease, transform 0.25s ease;
            backdrop-filter: blur(16px);
        }
        .env-block:hover .env-hover-panel {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }
        .header-controls { display: flex; align-items: center; }
        .btn-hud-gear {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(56, 189, 248, 0.4);
            color: #38bdf8;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.15);
        }
        .btn-hud-gear:hover {
            background: rgba(56, 189, 248, 0.25);
            color: #ffffff;
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.5);
            transform: rotate(90deg);
        }

        /* KPI ROW - HEXAGONS */
        .kpi-row { 
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            width: 100%; 
            height: 100%; 
            align-items: center;
        }
        
        .kpi-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            container-type: inline-size;
            gap: 2px;
        }
 
        .hex-card {
            position: relative;
            width: 98%;
            max-width: 100%;
            aspect-ratio: 120 / 104;
            display: flex; align-items: center; justify-content: center;
            filter: drop-shadow(0 0 12px var(--glow));
        }
        .hex-svg {
            position: absolute;
            inset: 0;
            width: 100%; height: 100%;
        }
        .hex-svg circle {
            transition: stroke-dashoffset 0.8s ease-in-out;
        }
        .hex-content {
            position: relative;
            z-index: 1;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center; width: 100%;
        }
        .hex-label { margin: 0; font-size: clamp(0.8rem, 10cqw, 1.25rem); font-weight: 700; color: #e2e8f0; text-transform: uppercase; letter-spacing: 1px; text-shadow: 0 1px 2px rgba(0,0,0,0.8); position: relative; z-index: 2; }
        .hex-val { font-size: clamp(1.5rem, 18cqw, 2.6rem); font-weight: 800; color: #fff; font-family: 'Share Tech Mono', monospace; line-height: 1; text-shadow: 0 0 10px rgba(255,255,255,0.4); }
        .hex-target { margin: 0; font-size: clamp(0.75rem, 8cqw, 1.05rem); color: #94a3b8; font-weight: 600; text-shadow: 0 1px 2px rgba(0,0,0,0.8); position: relative; z-index: 2; }
        .hex-mini-chart { width: 52%; height: clamp(14px, 2.2vh, 24px); margin-top: 2px; opacity: 0.85; }
        .pct-sign { font-family: 'Inter', sans-serif; font-size: 0.6em; font-weight: 600; margin-left: 2px; color: inherit; }
         
        .good { color: var(--c-green); } .warn { color: var(--c-orange); } .bad { color: var(--c-red); }

        /* MAIN DASHBOARD GRID */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 75% 25%;
            column-gap: 1%;
            flex: 1;
            min-height: 0;
        }
        .col-left {
            display: flex;
            flex-direction: column;
            gap: 1.5%;
            min-height: 0;
        }
        .col-right {
            display: grid;
            grid-template-rows: 20% 35.5% 20% 20%;
            row-gap: 1.5%;
            height: 100%;
            min-height: 0;
        }
        .detail-status-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 12px;
            flex: 1;
            min-height: 0;
        }
        #yieldRateGridContainer {
            display: grid;
            grid-template-rows: 25% 55% 20%;
            align-items: center;
            justify-items: center;
            container-type: inline-size;
        }
        #yieldRateGridContainer .yield-title {
            align-self: end;
            font-size: clamp(0.85rem, 8cqw, 1.5rem);
            font-weight: 700;
            color: #f8fafc;
            letter-spacing: 0.1vw;
            font-family: 'Inter', sans-serif;
            text-transform: uppercase;
            border-bottom: 2px solid rgba(255,255,255,0.2);
            padding-bottom: 4px;
            margin-bottom: 8px;
        }
        #g_yield_rate {
            align-self: center;
            font-size: clamp(2rem, 30cqw, 5.5rem);
            font-weight: 700;
            color: #6ee7b7;
            text-shadow: 0 0 20px rgba(110,231,183,0.3);
            line-height: 1;
            font-family: 'Inter', sans-serif;
            letter-spacing: -2px;
        }
        #g_yield_target {
            align-self: start;
            margin-top: 4px;
            font-size: clamp(0.75rem, 7cqw, 1.1rem);
            color: #cbd5e1;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
        }

        /* PANELS */
        .hud-panel {
            background: 
                /* Diagonal light sheen reflection */
                linear-gradient(125deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.02) 48%, rgba(255, 255, 255, 0.06) 50%, rgba(255, 255, 255, 0.02) 52%, rgba(255, 255, 255, 0) 60%, rgba(255, 255, 255, 0) 100%),
                var(--panel); 
            border: 1px solid var(--border); 
            border-top: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 12px;
            padding: 10px 14px; 
            display: flex; 
            flex-direction: column;
            overflow: hidden; 
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            box-shadow: 
                inset 0 20px 40px -15px rgba(255, 255, 255, 0.05), 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.2), 
                0 8px 32px 0 rgba(0, 0, 0, 0.35);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hud-panel:hover {
            border-color: rgba(56, 189, 248, 0.28);
            border-top-color: rgba(56, 189, 248, 0.65);
            background: 
                /* Shift the sheen slightly on hover for dynamic effect */
                linear-gradient(125deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 42%, rgba(255, 255, 255, 0.03) 49%, rgba(255, 255, 255, 0.08) 51%, rgba(255, 255, 255, 0.03) 53%, rgba(255, 255, 255, 0) 61%, rgba(255, 255, 255, 0) 100%),
                linear-gradient(135deg, rgba(47, 87, 138, 0.28) 0%, rgba(15, 32, 57, 0.15) 100%);
            box-shadow: 
                inset 0 25px 45px -15px rgba(255, 255, 255, 0.08), 
                inset 0 1px 0 0 rgba(255, 255, 255, 0.3), 
                0 16px 48px 0 rgba(0, 0, 0, 0.5), 
                0 0 25px 0 rgba(56, 189, 248, 0.12);
        }
        .panel-header {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 7px; margin-bottom: 7px;
            border-bottom: 1px solid var(--border); flex-shrink: 0;
        }
        .ph-left { display: flex; align-items: center; gap: 7px; }
        .ph-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pd, var(--c-cyan)); box-shadow: 0 0 6px var(--pd); }
        .ph-title { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; }
        .ph-badge { font-size: 0.7rem; font-weight: 700; padding: 3px 8px; border-radius: 8px; border: 1px solid; letter-spacing: 0.3px; }
        
        .bc { color:var(--c-cyan); border-color:rgba(56,189,248,0.3); background:rgba(56,189,248,0.08); }
        .bo { color:var(--c-orange); border-color:rgba(245,158,11,0.3); background:rgba(245,158,11,0.08); }
        .bg { color:var(--c-green); border-color:rgba(16,185,129,0.3); background:rgba(16,185,129,0.08); }
        .br { color:var(--c-red); border-color:rgba(239,68,68,0.3); background:rgba(239,68,68,0.08); }
        .bp { color:var(--c-purple); border-color:rgba(139,92,246,0.3); background:rgba(139,92,246,0.08); }

        .panel-body { flex: 1; min-height: 0; position: relative; }
        .chart-wrap { width: 100%; height: 100%; position: relative; }

        /* TABS */
        .tabs-header { display: flex; gap: 6px; }
        .tab-btn {
            background: transparent; border: 1px solid transparent; color: var(--muted);
            font-size: 0.85rem; font-weight: 700; text-transform: uppercase;
            padding: 5px 12px; border-radius: 4px; cursor: pointer; transition: all 0.2s;
            letter-spacing: 0.5px;
        }
        .tab-btn:hover { color: #fff; background: rgba(255,255,255,0.05); }
        .tab-btn.active { color: #fff; background: rgba(255,255,255,0.1); border-color: var(--border); }
        
        /* The tab contents must be absolutely positioned so they overlap and don't shrink to 0 size for ChartJS */
        .tab-content { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; z-index: 0; transition: opacity 0.2s; }
        .tab-content.active { opacity: 1; pointer-events: auto; z-index: 1; }

        /* Defect Layout */
        .defect-layout { display: flex; height: 100%; gap: 12px; }
        .defect-chart-wrap { width: 44%; display: flex; align-items: center; justify-content: center; }
        .defect-legend { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 9px; }
        .dli { display: flex; flex-direction: column; gap: 3px; }
        .dli-row { display: flex; align-items: center; gap: 7px; font-size: 0.67rem; color: var(--muted); font-weight: 600; }

        @@media (max-width: 1400px) {
            body { height: auto; overflow: auto; padding: 10px; }
            .dashboard-grid { grid-template-columns: 1fr; }
            .col-left { min-height: auto; }
            .col-right { display: flex; flex-direction: column; gap: 15px; }
            .detail-status-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 350px 350px; }
            .hud-panel { min-height: 200px; }

            /* KPI wrap responsiveness */
            #hud_kpi_panel { height: auto !important; padding: 20px 15px !important; }
            .kpi-row { grid-template-columns: repeat(3, 1fr); gap: 20px; }
            .kpi-col { height: auto; }
        }
        @@media (max-width: 900px) {
            .detail-status-grid { grid-template-columns: 1fr; grid-template-rows: repeat(4, 350px); }
            .hud-header { flex-direction: column; height: auto; align-items: flex-start; gap: 10px; padding-bottom: 15px; }
            
            /* 2 columns on tablet/medium screen */
            .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 15px; }
        }
        /* GEAR BUTTON & TARGET MODAL GLASSMORPHISM */
        .header-controls { display: flex; align-items: center; gap: 10px; margin-left: auto; }
        .btn-hud-gear {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(15, 23, 42, 0.6));
            border: 1px solid rgba(56, 189, 248, 0.4);
            color: #38bdf8;
            font-size: 1.15rem;
            width: 36px; height: 36px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.15);
        }
        .btn-hud-gear:hover {
            background: rgba(56, 189, 248, 0.3);
            color: #ffffff;
            border-color: #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.5);
            transform: rotate(45deg);
        }
        .target-modal-overlay {
            position: fixed; inset: 0; z-index: 10000;
            background: rgba(2, 6, 23, 0.75);
            backdrop-filter: blur(12px);
            display: flex; align-items: center; justify-content: center;
            padding: 20px;
            animation: fadeInModal 0.25s ease-out;
        }
        @@keyframes fadeInModal {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }
        .target-modal-container {
            width: 95vw; max-width: 1450px; max-height: 92vh;
            background: linear-gradient(135deg, rgba(30, 58, 95, 0.95) 0%, rgba(10, 22, 40, 0.98) 100%);
            border: 1px solid rgba(56, 189, 248, 0.35);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(56, 189, 248, 0.2);
            border-radius: 16px;
            display: flex; flex-direction: column;
            overflow: hidden;
            color: #f8fafc;
        }
        .target-modal-header {
            padding: 16px 24px;
            border-bottom: 1px solid rgba(56, 189, 248, 0.2);
            display: flex; align-items: center; justify-content: space-between;
            background: rgba(15, 23, 42, 0.5);
        }
        .target-modal-title { font-size: 1.1rem; font-weight: 700; color: #38bdf8; letter-spacing: 0.5px; }
        .target-modal-close {
            background: transparent; border: none; color: #94a3b8; font-size: 1.8rem; line-height: 1;
            cursor: pointer; transition: color 0.2s;
        }
        .target-modal-body { padding: 20px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 20px; }
        .modal-tab-bar {
            display: flex; gap: 10px; border-bottom: 1px solid rgba(56, 189, 248, 0.2); padding-bottom: 8px; margin-bottom: 4px;
        }
        .modal-tab-btn {
            background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(56, 189, 248, 0.2); color: #94a3b8;
            padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer;
            transition: all 0.2s ease; display: flex; align-items: center; gap: 6px;
        }
        .modal-tab-btn:hover { background: rgba(56, 189, 248, 0.15); color: #e2e8f0; }
        .modal-tab-btn.active {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.3), rgba(59, 130, 246, 0.3));
            border-color: #38bdf8; color: #38bdf8; box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        }
        .target-form-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px; padding: 16px;
        }
        .target-form-title { font-size: 0.9rem; font-weight: 700; color: #eab308; margin-bottom: 12px; }
        .target-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-group label { font-size: 0.75rem; font-weight: 600; color: #94a3b8; }
        .target-input, .target-select {
            background: rgba(2, 6, 23, 0.8);
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 6px; padding: 8px 12px; color: #ffffff; font-size: 0.85rem;
            outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        }
        .target-input:focus, .target-select:focus {
            border-color: #38bdf8; box-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
        }
        .target-select option { background: #0f172a; color: #ffffff; }
        .target-form-actions { display: flex; gap: 10px; margin-top: 14px; justify-content: flex-end; }
        .btn-target-save {
            background: linear-gradient(135deg, #10b981, #059669);
            border: none; color: #fff; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 0.85rem;
            cursor: pointer; transition: all 0.2s;
        }
        .btn-target-save:hover { box-shadow: 0 0 12px rgba(16, 185, 129, 0.5); transform: translateY(-1px); }
        .btn-target-reset {
            background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);
            color: #cbd5e1; padding: 8px 14px; border-radius: 6px; font-weight: 600; font-size: 0.85rem;
            cursor: pointer; transition: all 0.2s;
        }
        .btn-target-reset:hover { background: rgba(255, 255, 255, 0.15); color: #fff; }
        
        .target-list-title { font-size: 0.9rem; font-weight: 700; color: #38bdf8; }
        .target-table-wrap {
            max-height: 250px; overflow-y: auto; border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px; background: rgba(2, 6, 23, 0.5);
        }
        .target-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
        .target-table th {
            position: sticky; top: 0; background: #0f172a; color: #94a3b8; font-weight: 600;
            padding: 10px 12px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .target-table td { padding: 9px 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #e2e8f0; }
        .target-table tbody tr:hover { background: rgba(56, 189, 248, 0.08); }
