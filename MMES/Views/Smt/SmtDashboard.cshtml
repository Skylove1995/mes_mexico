        function getOutputByLineData() {
            let map = {};
            linesData.forEach(l => {
                let nameStr = l.name || l.lineName || (l.line ? `Line ${l.line}` : 'Line_1');
                let name = nameStr.replace('Line ', '').split(' ')[0];
