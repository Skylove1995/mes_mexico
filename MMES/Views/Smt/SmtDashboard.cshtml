            });
            let idle = idleTimeData.reduce((acc, val) => acc + val.idleTime, 0);
            
            let out = calcOut;
            let pr = calcInp > 0 ? (calcOut/calcInp*100) : 100;
            
            let targetSum = 0;
            for(let k in serverLineTargets) targetSum += serverLineTargets[k];
            const target = targetSum;
            
            const targetEl = document.getElementById('g_total_target_text');
            if(targetEl) {
                const targetValPlan = (globalSummaryData && globalSummaryData.totalTargetInputPlan > 0) ? globalSummaryData.totalTargetInputPlan : 0;
                if (targetValPlan > 0) {
                    const formattedTgt = targetValPlan >= 1000 ? (targetValPlan / 1000).toFixed(1) + 'K' : targetValPlan;
                    targetEl.innerHTML = `<span class="target-badge-pill" style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3); color: #38bdf8; font-weight: 700; font-size: 0.72rem; padding: 2px 8px; border-radius: 20px; display: inline-flex; align-items: center; gap: 4px; box-shadow: 0 0 8px rgba(14, 165, 233, 0.1);"><span style="width: 6px; height: 6px; border-radius: 50%; background: #38bdf8; display: inline-block;"></span>Target: ${formattedTgt} pcs</span>`;
                } else {
                    targetEl.innerHTML = `<span style="color: #ef4444; font-weight: 700; text-shadow: 0 0 6px rgba(239, 68, 68, 0.4);">Not Setup</span>`;
                }
            }

            if (globalSummaryData) {
                out = globalSummaryData.totalOutput || 0;
                pr = globalSummaryData.passRate || 100;
                
                const outMeterEl = document.getElementById('g_total_output_meter');
                if(outMeterEl) {
                    const c = 232.5;
                    const totVal = (globalSummaryData && globalSummaryData.totalTargetInputPlan > 0) ? globalSummaryData.totalTargetInputPlan : 0;
                    if (totVal > 0) {
                        const pct = Math.min((out / totVal) * 100, 100);
                        const offset = c - (pct / 100) * c;
                        outMeterEl.style.strokeDashoffset = offset;
                    } else {
                        outMeterEl.style.strokeDashoffset = c;
                    }
                }
            }

            const spiTargetEl = document.getElementById('g_spi_target_text');
            if(spiTargetEl) {
                spiTargetEl.innerHTML = renderTargetBadge("SPI PASS RATE", "Target ", "%");
            }
            const moiTargetEl = document.getElementById('g_moi_target_text');
            if(moiTargetEl) {
                moiTargetEl.innerHTML = renderTargetBadge("MOI PASS RATE", "Target ", "%");
            }
            const aoiTargetEl = document.getElementById('g_aoi_target_text');
            if(aoiTargetEl) {
                aoiTargetEl.innerHTML = renderTargetBadge("AOI PASS RATE", "Target ", "%");
            }
            const oeeTargetEl = document.getElementById('g_oee_target_text');
