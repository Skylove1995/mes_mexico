        function parseExcelProdDate(dayCol, monthCol) {
            if (!dayCol) return new Date().toISOString().split('T')[0];
            dayCol = dayCol.trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(dayCol)) return dayCol;
            const dmy = dayCol.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
            if (dmy) return `${dmy[3]}-${dmy[2].padStart(2, '0')}-${dmy[1].padStart(2, '0')}`;

            const dayMatch = dayCol.match(/^(\d{1,2})/);
            let dayNum = dayMatch ? parseInt(dayMatch[1], 10) : null;
            let monthNum = null;
            if (monthCol) {
                const mMatch = monthCol.toString().match(/\d+/);
                if (mMatch) monthNum = parseInt(mMatch[0], 10);
            }
            if (!monthNum) {
                const monthNames = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
                const lower = dayCol.toLowerCase();
                for (let i = 0; i < monthNames.length; i++) {
                    if (lower.includes(monthNames[i])) { monthNum = i + 1; break; }
                }
            }
            if (dayNum && monthNum) {
                const yearNum = new Date().getFullYear();
                return `${yearNum}-${String(monthNum).padStart(2, '0')}-${String(dayNum).padStart(2, '0')}`;
            }
            return dayCol;
        }

        function formatDateTimeStr(dateStr, timeStr) {
            if (!timeStr) return null;
            timeStr = timeStr.trim();
            if (!timeStr) return null;
            if (timeStr.includes('T') || timeStr.includes('-')) return timeStr.replace(' ', 'T');
            const parts = timeStr.split(':');
            if (parts.length >= 2) {
                const h = parts[0].padStart(2, '0');
                const m = parts[1].padStart(2, '0');
                const s = parts.length > 2 ? parts[2].padStart(2, '0') : '00';
                return `${dateStr}T${h}:${m}:${s}`;
            }
            return null;
        }

        function parseMinutesOrHours(valStr) {
            if (!valStr) return null;
            valStr = valStr.trim();
            if (!valStr) return null;
            if (valStr.includes(':')) {
                const parts = valStr.split(':');
                const h = parseFloat(parts[0]) || 0;
                const m = parseFloat(parts[1]) || 0;
                return Math.round((h + m / 60.0) * 100) / 100;
            }
            const num = parseFloat(valStr);
            if (isNaN(num)) return null;
            if (num >= 5) return Math.round((num / 60.0) * 100) / 100;
            return Math.round(num * 100) / 100;
        }

        function parseLossTimeExcelInput() {
            const rawText = (document.getElementById('ltExcelInput')?.value || '').trim();
            if (!rawText) return [];

            const lines = rawText.split('\n');
            const parsedList = [];

            lines.forEach((lineStr) => {
                if (!lineStr.trim()) return;
                const cols = lineStr.split('\t').map(c => c.trim());
                if (cols.length < 2) return;

                // Skip header row
                const col0Lower = cols[0].toLowerCase();
                if (col0Lower === 'day' || col0Lower.includes('date') || (cols.length > 1 && cols[1].toLowerCase() === 'month') || (cols.length > 2 && cols[2].toLowerCase() === 'line')) {
                    return;
                }

                let pDate, line, lane, side, st, et, idle, brk, mc, d1, d2, act, type, code;

                if (cols.length >= 15) {
                    // Full 27-column standard SMT Loss Time export format
                    pDate = parseExcelProdDate(cols[0], cols[1]);
                    line = cols[7] || cols[2] || '';
                    lane = cols[8] || '1';
                    type = cols.length > 26 ? cols[26] : (cols[9] || '');
                    st = formatDateTimeStr(pDate, cols[15]);
                    et = formatDateTimeStr(pDate, cols[16]);
                    idle = parseMinutesOrHours(cols.length > 19 && cols[19] ? cols[19] : cols[17]);
                    brk = parseMinutesOrHours(cols[18]);
                    code = cols.length > 20 ? cols[20] : '';
                    d1 = cols.length > 21 ? cols[21] : '';
                    side = cols.length > 22 && cols[22] ? cols[22] : 'TOP';
                    mc = cols.length > 23 ? cols[23] : '';
                    d2 = cols.length > 24 ? cols[24] : '';
                    act = cols.length > 25 ? cols[25] : '';
                } else {
                    // Short standard format
                    pDate = parseExcelProdDate(cols[0], '');
                    line = cols[1] || '';
                    lane = cols.length > 2 ? cols[2] : '1';
                    side = cols.length > 3 ? cols[3] : 'TOP';
                    st = formatDateTimeStr(pDate, cols.length > 4 ? cols[4] : null);
                    et = formatDateTimeStr(pDate, cols.length > 5 ? cols[5] : null);
                    idle = parseMinutesOrHours(cols.length > 6 ? cols[6] : null);
                    brk = parseMinutesOrHours(cols.length > 7 ? cols[7] : null);
                    mc = cols.length > 8 ? cols[8] : '';
                    d1 = cols.length > 9 ? cols[9] : '';
                    d2 = cols.length > 10 ? cols[10] : '';
                    act = cols.length > 11 ? cols[11] : '';
                    type = cols.length > 12 ? cols[12] : '';
                    code = cols.length > 13 ? cols[13] : '';
                }

                if (pDate && line) {
                    parsedList.push({
                        prodDate: pDate, line, lane, side,
                        startTime: st, endTime: et,
                        idleTime: idle, breakTime: brk,
                        machine: mc, detail1: d1, detail2: d2, action: act, type, code
                    });
                }
            });

            return parsedList;
        }

        function previewLossTimeExcel() {
            const previewArea = document.getElementById('ltExcelPreviewArea');
            const previewCount = document.getElementById('ltExcelPreviewCount');
            const previewBody = document.getElementById('ltExcelBody');

            const parsedList = parseLossTimeExcelInput();

            if (parsedList.length === 0) {
                alert("Vui lòng dán dữ liệu Excel hợp lệ vào ô văn bản!");
                if (previewArea) previewArea.style.display = 'none';
                return;
            }

            if (previewCount) previewCount.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> Tìm thấy ${parsedList.length} dòng Loss Time hợp lệ:`;

            if (previewBody) {
                previewBody.innerHTML = parsedList.map(item => `
                    <tr>
                        <td style="color: #f43f5e;">${escapeHtml(item.prodDate)}</td>
                        <td style="color: #38bdf8; font-weight: 700;">Line ${escapeHtml(item.line)}</td>
                        <td>Lane ${escapeHtml(item.lane)}</td>
                        <td>${escapeHtml(item.side)}</td>
                        <td style="color: #ef4444; font-weight: 700;">${item.idleTime != null ? item.idleTime + ' h' : '—'}</td>
                        <td style="color: #f59e0b; font-weight: 700;">${item.breakTime != null ? item.breakTime + ' h' : '—'}</td>
                        <td><span class="period-badge daily">${escapeHtml(item.code || '—')}</span></td>
                        <td><span style="color: #f43f5e; font-size: 0.75rem;">Upsert Loss Time</span></td>
                    </tr>
                `).join('');
            }

            if (previewArea) previewArea.style.display = 'block';
        }

        async function saveLossTimeExcelBatch() {
            const payloadList = parseLossTimeExcelInput();
            if (payloadList.length === 0) {
                alert("Không có dữ liệu hợp lệ để lưu! Vui lòng dán dữ liệu Excel.");
                return;
            }

            if (!confirm(`Xác nhận lưu ${payloadList.length} bản ghi Loss Time vào cơ sở dữ liệu?`)) return;

            try {
                const res = await fetch('/api/SmtApi/dashboard/save-loss-time-batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payloadList)
                });
                const result = await res.json();
                if (res.ok && result.success) {
                    alert(result.message || "Lưu hàng loạt Loss Time thành công!");
                    document.getElementById('ltExcelInput').value = '';
                    const previewArea = document.getElementById('ltExcelPreviewArea');
                    if (previewArea) previewArea.style.display = 'none';
                    await loadLossTimeTable();
                } else {
                    alert("Lưu thất bại: " + (result.message || "Lỗi không xác định"));
                }
            } catch(e) {
                alert("Lỗi khi kết nối API: " + e.message);
            }
        }

        window.addEventListener('DOMContentLoaded', async () => { 
            startClock(); 
            loadWismaxEnvData();
            await loadDashboardData(); 

            // Phase 1 Initial Load
            await loadPassRatePhase1();
            await loadPickupLossPhase1();
            await loadTotalOutputPhase1();

            // Automatic Refresh every 600s (10 minutes = 600000 ms)
            setInterval(async () => {
                await loadPassRatePhase1();
                await loadPickupLossPhase1();
                await loadTotalOutputPhase1();
            }, 600000);

            document.getElementById('targetName').addEventListener('input', renderPeriodEntryTable);
            document.getElementById('targetPeriod').addEventListener('change', renderPeriodEntryTable);
        });
    </script>

