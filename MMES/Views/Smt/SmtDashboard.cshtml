        function calculateMergedIdleHoursJS(records) {
            if (!records || records.length === 0) return 0;
            let intervals = [];
            let unspecIdle = 0;

            records.forEach(r => {
                if (r.startTime && r.endTime) {
                    let s = new Date(r.startTime).getTime();
                    let e = new Date(r.endTime).getTime();
                    if (!isNaN(s) && !isNaN(e) && e > s) {
                        intervals.push({ start: s, end: e });
                    } else if (r.idleTime) {
                        unspecIdle += r.idleTime;
                    }
                } else if (r.idleTime) {
                    unspecIdle += r.idleTime;
                }
            });

            if (intervals.length === 0) return unspecIdle;

            intervals.sort((a, b) => a.start - b.start);
            let merged = [intervals[0]];

            for (let i = 1; i < intervals.length; i++) {
                let current = merged[merged.length - 1];
                let next = intervals[i];
                if (next.start <= current.end) {
                    current.end = Math.max(current.end, next.end);
                } else {
                    merged.push(next);
                }
            }

            let mergedMs = merged.reduce((acc, inv) => acc + (inv.end - inv.start), 0);
            return (mergedMs / 3600000) + unspecIdle;
        }

        function renderOeeHoverPanel() {
            const panel = document.getElementById('oeeHoverDetailPanel');
            if (!panel) return;

            if (!linesData || linesData.length === 0) {
                panel.innerHTML = `
                    <div class="ohp-header" style="color: #60a5fa; border-bottom-color: rgba(59, 130, 246, 0.25);">
                        <span><i class="bi bi-cpu-fill me-1"></i> Detailed OEE By Line - Lane</span>
                    </div>
                    <div style="font-size: 0.75rem; color: #94a3b8; text-align: center; padding: 12px;">Đang tải dữ liệu...</div>`;
                return;
            }

            const mapLineLane = {};
            linesData.forEach(item => {
                const lCode = item.lineCode || item.line || (item.name ? item.name.match(/Line (\d+)/)?.[1] : '1');
                const laneCode = item.laneCode || item.lane || (item.name ? item.name.match(/_(\d+)/)?.[1] : '1');
                const key = `Line ${lCode} - Lane ${laneCode}`;
                const side = (item.side || 'TOP').toUpperCase();

                if (!mapLineLane[key]) {
                    mapLineLane[key] = {
                        key: key,
                        lineCode: lCode,
                        laneCode: laneCode,
                        output: 0,
                        input: 0,
                        targetPlan: 0,
                        side: side
                    };
                }

                // Prefer TOP side as it represents the final completed product of SMT process.
                const currentIsTop = mapLineLane[key].side === 'TOP';
                const newItemIsTop = side === 'TOP';

                if (newItemIsTop || !currentIsTop) {
                    mapLineLane[key].output = item.output || 0;
                    mapLineLane[key].input = item.totalInput || 0;
                    mapLineLane[key].side = side;
                }

                if (item.targetInputPlan) {
                    mapLineLane[key].targetPlan = item.targetInputPlan;
                }
            });

            const items = Object.values(mapLineLane);
            items.sort((a, b) => {
                const lA = parseInt(a.lineCode, 10) || 0;
                const lB = parseInt(b.lineCode, 10) || 0;
                if (lA !== lB) return lA - lB;
                return (parseInt(a.laneCode, 10) || 0) - (parseInt(b.laneCode, 10) || 0);
            });

            let html = `
                <div class="ohp-header" style="color: #60a5fa; border-bottom-color: rgba(59, 130, 246, 0.25);">
                    <span><i class="bi bi-cpu-fill me-1"></i> Detailed OEE By Line - Lane</span>
                    <span style="font-size: 0.7rem; color: #94a3b8; font-weight: 500;">(${items.length} Lanes)</span>
                </div>
                <div class="ohp-grid-2col">`;

            // Calculate realtime elapsed hours from 08:00 AM to now
            const now = new Date();
            let shiftStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 8, 0, 0);
            if (now < shiftStart) {
                shiftStart.setDate(shiftStart.getDate() - 1);
            }
            const elapsedHours = Math.max(0.1, Math.min(24.0, (now - shiftStart) / 3600000));
            const shiftHoursPerLane = 19.75;
            const realtimeRatio = Math.min(1.0, elapsedHours / shiftHoursPerLane);

            items.forEach(it => {
                const lCode = it.lineCode;
                const laneCode = it.laneCode;
                let laneIdleRecords = [];
                if (typeof idleTimeData !== 'undefined' && Array.isArray(idleTimeData)) {
                    laneIdleRecords = idleTimeData.filter(idl => {
                        const matchLine = idl.line === lCode || idl.line === `Line ${lCode}` || idl.lineCode === lCode;
                        const matchLane = !idl.lane || idl.lane === laneCode || idl.laneCode === laneCode;
                        return matchLine && matchLane;
                    });
                }

                const laneIdleHours = calculateMergedIdleHoursJS(laneIdleRecords);
                const laneRealtimePlannedHours = elapsedHours;

                // 1. Availability (elapsed 08:00 to now vs idle time)
                const availPct = laneRealtimePlannedHours > 0 
                    ? Math.max(0, Math.min(100, ((laneRealtimePlannedHours - laneIdleHours) / laneRealtimePlannedHours) * 100))
                    : 100;

                // 2. Performance (pro-rated target plan for this lane)
                const laneRealtimeTargetPlan = (it.targetPlan || 0) * realtimeRatio;
                const perfPct = laneRealtimeTargetPlan > 0 ? Math.min(100, (it.output / laneRealtimeTargetPlan) * 100) : 0;

                // 3. Quality (Pass Rate)
                const qualPct = it.input > 0 ? Math.min(100, (it.output / it.input) * 100) : 100;

                // 4. Lane OEE
                const laneOee = (availPct / 100) * (perfPct / 100) * (qualPct / 100) * 100;

                const isGood = laneOee >= 85;

                html += `
                    <div class="ohp-row">
                        <div class="ohp-row-header">
                            <span class="ohp-line-title">${it.key}</span>
                            <span class="ohp-line-stats">
                                OEE: <span style="font-size: 0.85rem; font-weight: 800; color: ${isGood ? '#34d399' : '#60a5fa'};">${laneOee.toFixed(1)}%</span>
                            </span>
                        </div>
                        <div style="font-size: 0.68rem; color: #94a3b8; display: flex; gap: 8px; margin-bottom: 2px;">
                            <span>A: <strong style="color:#38bdf8;">${availPct.toFixed(1)}%</strong></span>
                            <span>P: <strong style="color:#a855f7;">${perfPct.toFixed(1)}%</strong></span>
                            <span>Q: <strong style="color:#34d399;">${qualPct.toFixed(1)}%</strong></span>
                        </div>
                        <div class="ohp-bar-track">
                            <div class="ohp-bar-output" style="width: ${Math.min(100, Math.round(laneOee))}%; background: linear-gradient(90deg, #3b82f6 0%, #06b6d4 100%); box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);"></div>
                        </div>
                    </div>`;
            });

            html += `</div>`;
            panel.innerHTML = html;
        }

        function renderOutputHoverPanel() {
            const panel = document.getElementById('outputHoverDetailPanel');
            if (!panel) return;

            if (!linesData || linesData.length === 0) {
                panel.innerHTML = `
                    <div class="ohp-header">
                        <span><i class="bi bi-bar-chart-line-fill me-1"></i> Output & Target By Line - Lane</span>
                    </div>
                    <div style="font-size: 0.75rem; color: #94a3b8; text-align: center; padding: 12px;">Đang tải dữ liệu...</div>`;
                return;
            }

            const mapLineLane = {};
            linesData.forEach(item => {
                const lCode = item.lineCode || item.line || (item.name ? item.name.match(/Line (\d+)/)?.[1] : '1');
                const laneCode = item.laneCode || item.lane || (item.name ? item.name.match(/_(\d+)/)?.[1] : '1');
                const key = `Line ${lCode} - Lane ${laneCode}`;
                const side = (item.side || 'TOP').toUpperCase();
                
                if (!mapLineLane[key]) {
                    mapLineLane[key] = {
                        key: key,
                        lineCode: lCode,
                        laneCode: laneCode,
                        output: 0,
                        target: item.targetInputPlan || 0,
                        side: side
                    };
                }

                // Prefer TOP side as it represents the final completed product of SMT process.
                const currentIsTop = mapLineLane[key].side === 'TOP';
                const newItemIsTop = side === 'TOP';

                if (newItemIsTop || !currentIsTop) {
                    mapLineLane[key].output = item.output || 0;
                    mapLineLane[key].side = side;
                }

                if (!mapLineLane[key].target && item.targetInputPlan) {
                    mapLineLane[key].target = item.targetInputPlan;
                }
            });

            const items = Object.values(mapLineLane);
            items.sort((a, b) => {
                const lA = parseInt(a.lineCode, 10) || 0;
                const lB = parseInt(b.lineCode, 10) || 0;
                if (lA !== lB) return lA - lB;
                return (parseInt(a.laneCode, 10) || 0) - (parseInt(b.laneCode, 10) || 0);
            });

            let html = `
                <div class="ohp-header">
                    <span><i class="bi bi-bar-chart-line-fill me-1"></i> Output & Target Theo Line - Lane</span>
                    <span style="font-size: 0.7rem; color: #94a3b8; font-weight: 500;">(${items.length} Lanes)</span>
                </div>
                <div class="ohp-grid-2col">`;

            items.forEach(it => {
                const out = it.output || 0;
                const tgt = it.target || 0;
                const pct = tgt > 0 ? ((out / tgt) * 100).toFixed(1) : '0.0';
                const isExceeded = tgt > 0 && out >= tgt;
                
                const scaleMax = Math.max(out, tgt, 1);
                const tgtWidthPct = Math.min(100, Math.round((tgt / scaleMax) * 100));
                const outWidthPct = Math.min(100, Math.round((out / scaleMax) * 100));

                html += `
                    <div class="ohp-row">
                        <div class="ohp-row-header">
                            <span class="ohp-line-title">${it.key}</span>
                            <span class="ohp-line-stats">
                                <span class="out">${formatNumber(out)}</span> / <span class="tgt">${tgt > 0 ? formatNumber(tgt) : '—'}</span> pcs 
                                (<span class="pct" style="${isExceeded ? 'color:#34d399;' : ''}">${pct}%</span>)
                            </span>
                        </div>
                        <div class="ohp-bar-track">
                            <div class="ohp-bar-target" style="width: ${tgtWidthPct}%;"></div>
                            <div class="ohp-bar-output ${isExceeded ? 'exceeded' : ''}" style="width: ${outWidthPct}%;"></div>
                        </div>
                    </div>`;
            });

            html += `</div>`;
            panel.innerHTML = html;
        }

        function getDefectColors() { return ['#ef4444', '#f59e0b', '#38bdf8', '#10b981', '#8b5cf6']; }

        function renderDefectLegend(data, colors, total) {
            const container = document.getElementById('defectLegendContainer');
            if (!container) return;
            let html = '';
            
            let displayData = [];
            if (data.length <= 3) {
                displayData = [...data];
            } else {
                displayData = data.slice(0, 3);
                const otherCount = data.slice(3).reduce((sum, d) => sum + d.count, 0);
                displayData.push({ name: "Other", count: otherCount });
            }

            displayData.forEach((d, i) => {
                const color = colors[i % colors.length];
                const pct = total > 0 ? Math.round((d.count / total) * 100) : 0;
                html += `
                    <div class="dli">
                        <div class="dli-row"><div class="dli-dot" style="background:${color};"></div>${d.name}</div>
                        <div class="dli-val">${formatNumber(d.count)} (${pct}%)</div>
                        <div class="dli-bar"><div class="dli-bar-fill" style="width:${pct}%;background:${color};"></div></div>
                    </div>`;
            });
            if (data.length === 0) {
                html = '<div style="color:var(--muted);font-size:0.8rem;text-align:center;padding-top:20px;">No defects recorded</div>';
            }
            container.innerHTML = html;
        }

        function getCurrentDefects() {
            if (currentDefectLine === 'ALL') {
                return defectData.global || [];
            } else if (currentDefectLine === 'OTHER') {
                const top3Names = getTop3DefectLines();
                const otherLines = (defectData.byLine || []).filter(l => !top3Names.includes(l.lineName));
                const agg = {};
                otherLines.forEach(l => {
                    l.defects.forEach(d => {
                        agg[d.name] = (agg[d.name] || 0) + d.count;
                    });
                });
                return Object.keys(agg).map(name => ({ name, count: agg[name] })).sort((a,b) => b.count - a.count);
            } else {
                const found = (defectData.byLine || []).find(l => l.lineName === currentDefectLine);
                return found ? found.defects : [];
            }
        }

        function initDefectChart(){
            const c=document.getElementById('defectChart'); if(!c) return;
            const colors = getDefectColors();
            const currentDefects = getCurrentDefects();
            
            let displayDefects = [];
            if (currentDefects.length <= 3) {
                displayDefects = [...currentDefects];
            } else {
                displayDefects = currentDefects.slice(0, 3);
                const otherCount = currentDefects.slice(3).reduce((sum, d) => sum + d.count, 0);
                displayDefects.push({ name: "Other", count: otherCount });
            }

            let labels = displayDefects.map(d => d.name);
            let counts = displayDefects.map(d => d.count);
            let total = counts.reduce((a, b) => a + b, 0);

            if(currentDefects.length === 0) { labels = ['No Data']; counts = [1]; total = 0; }
            renderDefectLegend(currentDefects, colors, total);

            defectChart=new Chart(c.getContext('2d'),{
                type:'doughnut',
                data:{ labels: labels, datasets:[{ data: counts, backgroundColor: displayDefects.length > 0 ? colors : ['#334155'], borderWidth:1, borderColor:'#0f172a' }] },
                options:{ 
                    responsive:true, maintainAspectRatio:false, cutout:'70%', 
                    plugins:{
                        legend:{display:false},
                        datalabels: { color: '#fff', font: { weight: 'bold', size: 10, family: 'Inter' }, formatter: v => v > 0 ? v : '' }
                    } 
                }
            });
        }

        function updateDefectChart() {
            if(!defectChart) return;
            const colors = getDefectColors();
            const currentDefects = getCurrentDefects();
            
            let displayDefects = [];
            if (currentDefects.length <= 3) {
                displayDefects = [...currentDefects];
            } else {
                displayDefects = currentDefects.slice(0, 3);
                const otherCount = currentDefects.slice(3).reduce((sum, d) => sum + d.count, 0);
                displayDefects.push({ name: "Other", count: otherCount });
            }

            let labels = displayDefects.map(d => d.name);
            let counts = displayDefects.map(d => d.count);
            let total = counts.reduce((a, b) => a + b, 0);

            if(currentDefects.length === 0) { labels = ['No Data']; counts = [1]; }
            renderDefectLegend(currentDefects, colors, total);

            defectChart.data.labels = labels;
            defectChart.data.datasets[0].data = counts;
            defectChart.data.datasets[0].backgroundColor = displayDefects.length > 0 ? colors : ['#334155'];
            defectChart.update();
        }

        function getDefectDensityData(dataList) {
            const points = [];
            (dataList || []).forEach((t, xIndex) => {
                const count = t.defect || 0;
                for (let y = 1; y <= count; y++) {
                    points.push({ x: xIndex, y: y });
                }
            });
            return points;
        }

        const getPastDaysData = (count) => {
            const labels = [];
            const dates = [];
            const d = new Date();
            for (let i = count - 1; i >= 0; i--) {
                const temp = new Date(d);
                temp.setDate(d.getDate() - i);
                labels.push(`${String(temp.getDate()).padStart(2, '0')}/${String(temp.getMonth() + 1).padStart(2, '0')}`);
                dates.push({ year: temp.getFullYear(), month: temp.getMonth() + 1, day: temp.getDate() });
            }
            return { labels, dates };
        };

        const getDefect7DaysData = () => {
            const { labels, dates } = getPastDaysData(7);
            let data = [];
            if (serverDefect7Days && serverDefect7Days.length > 0) {
                data = serverDefect7Days.map(item => item.ppm != null ? item.ppm : (item.defects || 0));
            } else {
                data = [0, 0, 0, 0, 0, 0, 0];
            }
            return { labels, dates, data };
