                                boxWidth: 12, 
                                font: { family: 'Inter', size: 10 },
                                filter: function(item, chartData) {
                                    const index = item.datasetIndex !== undefined ? item.datasetIndex : item.index;
                                    if (currentDashboardViewMode === 'CUSTOMER' && index === 1) {
                                        return false;
                                    }
                                    return true;
                                }
                            } 
                        },
                        datalabels: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const val = context.raw;
                                    const isCust = currentDashboardViewMode === 'CUSTOMER';
                                    if (context.datasetIndex === 1) {
                                        if (isCust) {
                                            return ` Target OEE: ${val}%`;
                                        }
                                        return ` Target Limit: ${val} PPM`;
                                    }
                                    if (isCust) {
                                        const idx = context.dataIndex;
                                        const item = (serverOee7Days && serverOee7Days[idx]) || {};
                                        const avail = item.availability != null ? item.availability : 0;
                                        const qual = item.quality != null ? item.quality : 0;
                                        return ` OEE Rate: ${Number(val).toFixed(2)}% (Avail: ${avail}%, Quality: ${qual}%)`;
                                    }
                                    const idx = context.dataIndex;
                                    const item = (serverDefect7Days && serverDefect7Days[idx]) || {};
                                    const defCount = item.defects != null ? item.defects : 0;
                                    return ` Actual: ${val} PPM (${formatNumber(defCount)} defects)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#94a3b8', font: { size: 12, family: 'Inter' } } },
                        y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#94a3b8', font: { size: 12, family: 'Inter' }, callback: v => Number(v).toFixed(1) + (currentDashboardViewMode === 'CUSTOMER' ? '%' : ' PPM') }, min: 0, suggestedMax: defectMaxVal * 1.15 }
                    }
                }
            });
            updateTrendCharts();
        }

        function updateTrendCharts() {
            if (!outputTrendChart || !upphTrendChart || !defectTrendChart) return;
            
            // Update Output Trend (Last 7 Days)
            const outputDays = getOutput7DaysData();
            const outputTargetData = (outputDays.targetData && outputDays.targetData.some(v => v > 0))
                ? outputDays.targetData
                : outputDays.dates.map(() => (globalSummaryData && globalSummaryData.totalTargetInputPlan != null) ? globalSummaryData.totalTargetInputPlan : 0);
            outputTrendChart.data.labels = outputDays.labels;
            outputTrendChart.data.datasets[0].data = outputDays.data;
            outputTrendChart.data.datasets[1].data = outputTargetData;
            const outputMaxVal = Math.max(...outputDays.data, ...(outputTargetData.filter(v => v != null)), 0);
            outputTrendChart.options.scales.y.suggestedMax = outputMaxVal * 1.15;
            outputTrendChart.update();

            // Update UPPH (Last 7 Days)
            const upphDays = getUpphDaysData();
            const upphTargetData = upphDays.dates.map(dt => getTargetValueForDay("UPPH", dt.year, dt.month, dt.day));
            upphTrendChart.data.labels = upphDays.labels;
            upphTrendChart.data.datasets[0].data = upphDays.data;
            upphTrendChart.data.datasets[1].data = upphTargetData;
            const upphMaxVal = Math.max(...upphDays.data, ...(upphTargetData.filter(v => v != null)), 0);
            upphTrendChart.options.scales.y.suggestedMax = upphMaxVal * 1.15;
            upphTrendChart.update();

            // Update 3rd Trend Chart (AOI Defects in HSE Mode vs OEE Trend in CUSTOMER Mode)
            const isCustomer = currentDashboardViewMode === 'CUSTOMER';
            const defectTitleText = document.getElementById('defectTrendTitleText');
            const defectDot = document.getElementById('defectTrendDot');

            if (isCustomer) {
                if (defectTitleText) defectTitleText.innerText = 'OEE Trend (Last 7 Days)';
                if (defectDot) defectDot.style.setProperty('--pd', '#3b82f6');

                const oeeDays = getOee7DaysData();
                defectTrendChart.data.labels = oeeDays.labels;
                defectTrendChart.data.datasets[0].label = 'OEE Rate (%)';
                defectTrendChart.data.datasets[0].data = oeeDays.data;
                defectTrendChart.data.datasets[0].borderColor = '#3b82f6';
                defectTrendChart.data.datasets[0].backgroundColor = 'rgba(59, 130, 246, 0.15)';

                // Hide the target line in Customer mode
                defectTrendChart.data.datasets[1].hidden = true;
                defectTrendChart.data.datasets[1].data = [];

                if (defectTrendChart.options.scales.y.ticks) {
                    defectTrendChart.options.scales.y.ticks.callback = v => Number(v).toFixed(1) + '%';
                }

                // Scale Y-axis to see the change easier
                const oeeVals = oeeDays.data.filter(v => v != null && v > 0);
                const minOee = oeeVals.length > 0 ? Math.min(...oeeVals) : 80;
                const maxOee = oeeVals.length > 0 ? Math.max(...oeeVals) : 100;
                defectTrendChart.options.scales.y.min = Math.max(0, Math.floor(minOee - 2));
                defectTrendChart.options.scales.y.max = Math.min(100, Math.ceil(maxOee + 2));
                defectTrendChart.options.scales.y.suggestedMax = undefined;

                defectTrendChart.update();
            } else {
                if (defectTitleText) defectTitleText.innerText = 'AOI Defect Trend (Last 7 Days)';
                if (defectDot) defectDot.style.setProperty('--pd', '#ef4444');

                const defectDays = getDefect7DaysData();
                const defectTargetData = defectDays.dates.map(dt => getTargetValueForDay("DEFECT TREND", dt.year, dt.month, dt.day));
                defectTrendChart.data.labels = defectDays.labels;
                defectTrendChart.data.datasets[0].label = 'AOI Defects (PPM)';
                defectTrendChart.data.datasets[0].data = defectDays.data;
                defectTrendChart.data.datasets[0].borderColor = '#f43f5e';
                defectTrendChart.data.datasets[0].backgroundColor = 'rgba(244, 63, 94, 0.15)';

                // Show the target line in HSE mode
                defectTrendChart.data.datasets[1].label = 'PPM Target Limit';
                defectTrendChart.data.datasets[1].data = defectTargetData;
                defectTrendChart.data.datasets[1].borderColor = 'rgba(16, 185, 129, 0.95)';
                defectTrendChart.data.datasets[1].hidden = false;

                const defectMaxVal = Math.max(...defectDays.data, ...(defectTargetData.filter(v => v != null)), 0);
                if (defectTrendChart.options.scales.y.ticks) {
                    defectTrendChart.options.scales.y.ticks.callback = v => Number(v).toFixed(1) + ' PPM';
                }
                
                // Restore normal scaling for HSE mode
                defectTrendChart.options.scales.y.min = 0;
                defectTrendChart.options.scales.y.max = undefined;
                defectTrendChart.options.scales.y.suggestedMax = defectMaxVal * 1.15;

                defectTrendChart.update();
            }
        }

