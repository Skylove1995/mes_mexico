@{
    Layout = null;
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SMT Pass Rate - MMES</title>
    <script>
        (function () {
            var hour = new Date().getHours();
            document.documentElement.setAttribute('data-theme', (hour >= 6 && hour < 18) ? 'light' : 'dark');
        })();
    </script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/production-rate.css" asp-append-version="true" />
</head>

<body class="dashboard-page">
    <partial name="_DashboardHeader" />

    <main id="top" class="pr-container">
        <!-- Toolbar Header Banner with Integrated Pass Rate Overview KPIs -->
        <section class="glass pr-toolbar">
            <div class="pr-title-group">
                <p class="eyebrow">SMT PRODUCTION MONITORING</p>
                <h1>SMT Pass Rate Dashboard</h1>
            </div>

            <!-- 🏆 Line-by-Line KPI Overview Summary Table -->
            <div class="pr-line-kpi-wrap glass">
                <div class="pr-line-kpi-header">
                    <span class="pr-line-kpi-title">📊 LINE PERFORMANCE OVERVIEW</span>
                </div>
                <div class="pr-line-kpi-table-container">
                    <table class="pr-kpi-summary-table" id="pr-kpi-summary-table">
                        <thead>
                            <tr>
                                <th>LINE</th>
                                <th>SHIFT 1 PASS RATE</th>
                                <th>SHIFT 2 PASS RATE</th>
                                <th>OVERALL EFFICIENCY</th>
                            </tr>
                        </thead>
                        <tbody id="pr-kpi-summary-tbody">
                            <!-- Populated dynamically via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pr-toolbar-right">
                <label class="pr-date-field">
                    <span>Date</span>
                    <input type="date" id="pr-date">
                </label>
                <div class="pr-status-badge">
                    <span class="pr-live-dot"></span>
                    <span class="pr-updated" id="pr-updated" aria-live="polite">Loading...</span>
                </div>
            </div>
        </section>

        <!-- Machine Tabs & Threshold Legend -->
        <div class="pr-tabs-bar">
            <div class="pr-tabs" role="tablist" aria-label="Machine type">
                <button type="button" role="tab" data-type="SPI" aria-selected="true">
                    <span class="tab-icon">⚡</span> SPI Inspection
                </button>
                <button type="button" role="tab" data-type="MOI" aria-selected="false">
                    <span class="tab-icon">🔍</span> MOI Inspection
                </button>
                <button type="button" role="tab" data-type="AOI" aria-selected="false">
                    <span class="tab-icon">🎯</span> AOI Inspection
                </button>
            </div>
            <div class="pr-threshold-legend">
                <span class="legend-badge is-normal">≤ 5.0% Normal</span>
                <span class="legend-badge is-danger">🚨 &gt; 5.0% Exceeded (High Defect)</span>
            </div>
        </div>

        <!-- 🏆 PRIMARY CENTER FOCUS: DAY & NIGHT SHIFT MATRICES -->
        <section class="pr-primary-matrices">
            <!-- Day Shift Matrix Card -->
            <div class="glass pr-shift-block pr-main-matrix">
                <div class="pr-block-head">
                    <div class="pr-matrix-title">
                        <span class="pr-shift-icon">☀️</span>
                        <h2>Day Shift Matrix <span class="pr-shift-range">08:00 - 20:00 (Shift 1)</span></h2>
                    </div>
                    <span class="pr-matrix-pill">Main Matrix</span>
                </div>
                <div class="pr-table-wrap">
                    <table class="pr-table" id="pr-table-day"></table>
                </div>
            </div>

            <!-- Night Shift Matrix Card -->
            <div class="glass pr-shift-block pr-main-matrix">
                <div class="pr-block-head">
                    <div class="pr-matrix-title">
                        <span class="pr-shift-icon">🌙</span>
                        <h2>Night Shift Matrix <span class="pr-shift-range">20:00 (prev. day) - 08:00 (Shift 2)</span></h2>
                    </div>
                    <span class="pr-matrix-pill">Main Matrix</span>
                </div>
                <div class="pr-table-wrap">
                    <table class="pr-table" id="pr-table-night"></table>
                </div>
            </div>
        </section>

        <!-- 📊 MONTHLY OVERALL TREND SECTION -->
        <section class="pr-secondary-section pr-monthly-section">
            <div class="pr-section-header">
                <div class="pr-section-title-group">
                    <h3>Monthly Overall Pass Rate Trend</h3>
                    <span class="pr-section-subtitle">24-Hour Production Timeline per Day (20:00 Prev. Day to 20:00 Current Day)</span>
                </div>
                <div class="pr-monthly-filter">
                    <label class="pr-date-field">
                        <span>Select Month</span>
                        <input type="month" id="pr-month">
                    </label>
                </div>
            </div>

            <!-- Fullwidth Monthly Trend Chart Card -->
            <div class="glass pr-chart-card is-fullwidth pr-monthly-chart-card">
                <div class="pr-chart-head">
                    <div>
                        <h4 id="pr-monthly-chart-title">Monthly Overall Performance Trend</h4>
                        <span class="pr-shift-range">Daily Overall Average Across All Lines</span>
                    </div>
                    <div class="pr-legend">
                        <span class="legend-item"><span class="legend-dot is-line"></span> Daily Pass Rate Trend</span>
                        <span class="legend-item"><span class="legend-dot is-threshold"></span> 5.0% Max Limit</span>
                    </div>
                </div>
                <div class="pr-chart-container">
                    <svg class="pr-chart" id="pr-chart-monthly" viewBox="0 0 1000 240" preserveAspectRatio="none" role="img" aria-label="Monthly overall pass rate trend"></svg>
                    <div class="pr-chart-axis" id="pr-chart-monthly-axis"></div>
                </div>
            </div>
        </section>

    </main>

    <script src="~/js/production-rate.js" asp-append-version="true"></script>

    <script src="~/js/theme-clock.js" asp-append-version="true"></script>
</body>
</html>



